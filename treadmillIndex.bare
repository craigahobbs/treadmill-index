include <args.bare>
include <dataLineChart.bare>
include <forms.bare>
include <markdown.bare>


# The Treadmill Index application main entry point
async function tiMain():
    args = argsParse(tiArguments)
    page = objectGet(args, 'page')

    # Load the data
    cik = objectGet(args, 'cik')
    needIndex = page == 'index' || page == 'explore'
    urls = ['data/meta.json']
    if needIndex:
        arrayPush(urls, 'data/index.json')
    elif page == 'company' && cik != null:
        arrayPush(urls, 'data/company/' + cik + '.json')
    elif page == 'downloads':
        arrayPush(urls, 'data/archive/builds.json')
    endif
    texts = systemFetch(urls)
    meta = if(arrayGet(texts, 0) != null, jsonParse(arrayGet(texts, 0)))
    data = if(arrayLength(texts) > 1 && arrayGet(texts, 1) != null, jsonParse(arrayGet(texts, 1)))

    # Render the menu
    menu = []
    for menuPage in tiPages:
        menuName = objectGet(menuPage, 'name')
        menuTitle = objectGet(menuPage, 'title')
        arrayPush(menu, if(menuName == page, menuTitle, argsLink(tiArguments, menuTitle, {'page': menuName}, true, argsTopHeaderId)))
    endfor
    markdownPrint(arrayJoin(menu, ' | '))

    # Render the page
    if meta == null:
        documentSetTitle(tiTitle)
        markdownPrint('', '# ' + tiTitle, '', 'The index data failed to load.')
        return
    endif
    if page == 'company':
        tiCompanyPage(args, meta, cik, data)
    elif page == 'method':
        tiMethodPage(meta)
    elif page == 'data':
        tiDataPage(meta)
    elif page == 'totals':
        tiTotalsPage(meta)
    elif page == 'downloads':
        tiDownloadsPage(data)
    elif page == 'explore':
        tiExplorePage(args, meta, data)
    else:
        tiIndexPage(args, meta, data)
    endif

    # Render the footer
    markdownPrint( \
        '', \
        '---', \
        '', \
        'Data as of ' + objectGet(meta, 'dataDate') + ', from SEC filings. Method version ' + objectGet(meta, 'methodVersion') + '.', \
        'History starts about 2009, when the SEC began collecting financial statements as data.', \
        '', \
        'The index ranks how outside owners have been treated. It is not a short list, a price forecast or investment advice,', \
        "and it makes no finding about any one company's intent." \
    )
endfunction


# The application title
tiTitle = 'The Treadmill Index'


# The application pages
tiPages = [ \
    {'name': 'index', 'title': 'Index'}, \
    {'name': 'totals', 'title': 'Group totals'}, \
    {'name': 'explore', 'title': 'Threshold explorer'}, \
    {'name': 'method', 'title': 'Methodology'}, \
    {'name': 'data', 'title': 'Data and limits'}, \
    {'name': 'downloads', 'title': 'Downloads'} \
]


# The thresholds the explorer page can move - the URL argument, the meta.json threshold, and a description
tiExploreThresholds = [ \
    {'arg': 'line', 'key': 'meaningful_margin', 'percent': true, 'label': 'Meaningful owner cash, as a share of revenue'}, \
    {'arg': 'sbcRevenue', 'key': 'sbc_revenue_min', 'percent': true, 'label': 'Stock pay is the cause: least stock pay, as a share of revenue'}, \
    {'arg': 'sbcFcf', 'key': 'sbc_fcf_min', 'percent': true, 'label': 'Stock pay is the cause: least stock pay, as a share of free cash flow'}, \
    {'arg': 'cumZero', 'key': 'p1_cum_zero', 'percent': true, 'label': 'P1: cumulative owner-cash margin that scores 0'}, \
    {'arg': 'cumFull', 'key': 'p1_cum_full', 'percent': true, 'label': 'P1: cumulative owner-cash margin that scores 8'}, \
    {'arg': 'latestZero', 'key': 'p1_latest_zero', 'percent': true, 'label': 'P1: latest owner-cash margin that scores 0'}, \
    {'arg': 'latestFull', 'key': 'p1_latest_full', 'percent': true, 'label': 'P1: latest owner-cash margin that scores 7'}, \
    {'arg': 'drop', 'key': 'p2b_zero_drop', 'percent': false, 'label': 'P2b: fall in the cost ratio, in points of revenue, that scores 0'} \
]


# The application arguments
tiArguments = argsValidate([ \
    {'name': 'page', 'default': 'index'}, \
    {'name': 'cik', 'type': 'int'}, \
    {'name': 'type', 'default': 'stock_pay'}, \
    {'name': 'sort', 'default': 'three'}, \
    {'name': 'sic', 'type': 'int'}, \
    {'name': 'find'}, \
    {'name': 'all', 'type': 'bool', 'default': false}, \
    {'name': 'person', 'type': 'int', 'explicit': true}, \
    {'name': 'line', 'type': 'float'}, \
    {'name': 'sbcRevenue', 'type': 'float'}, \
    {'name': 'sbcFcf', 'type': 'float'}, \
    {'name': 'cumZero', 'type': 'float'}, \
    {'name': 'cumFull', 'type': 'float'}, \
    {'name': 'latestZero', 'type': 'float'}, \
    {'name': 'latestFull', 'type': 'float'}, \
    {'name': 'drop', 'type': 'float'} \
])


# The company types, in display order
tiTypes = [ \
    {'name': 'stock_pay', 'title': 'Stock pay', 'text': 'Passed the screen: owner cash is under the line and stock pay is the cause.'}, \
    {'name': 'thin_margin', 'title': 'Thin margin', 'text': 'Owner cash is under the line, but stock pay is too small to be the cause.'}, \
    {'name': 'cash_burner', 'title': 'Cash burner', 'text': 'Free cash flow is negative before any stock pay.'}, \
    {'name': 'cash_generative', 'title': 'Cash generative', 'text': 'Owner cash is at or above the line. These companies are the baseline.'}, \
    {'name': 'excluded', 'title': 'Excluded industry', 'text': 'A bank, insurer, lender, broker, asset manager, REIT or drug developer.'} \
]


# The index sort orders - the row field and whether it sorts descending
tiSorts = [ \
    {'name': 'three', 'title': 'Three signs', 'field': 'threeScore', 'desc': true}, \
    {'name': 'rank', 'title': 'Screen rank'}, \
    {'name': 'p1', 'title': 'P1', 'field': 'p1', 'desc': true}, \
    {'name': 'cum', 'title': 'Cumulative margin', 'field': 'cumMargin', 'desc': false}, \
    {'name': 'latest', 'title': 'Latest margin', 'field': 'latestMargin', 'desc': false}, \
    {'name': 'pay', 'title': 'Stock pay', 'field': 'sbcRevenue', 'desc': true}, \
    {'name': 'revenue', 'title': 'Revenue', 'field': 'revenue', 'desc': true}, \
    {'name': 'insider', 'title': 'Insider sales', 'field': 'insiderSales', 'desc': true}, \

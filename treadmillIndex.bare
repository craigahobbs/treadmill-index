    {'name': 'name', 'title': 'Name', 'field': 'name', 'desc': false} \
]


# The row notes - the code shown in the index table and what it means
tiNotes = [ \
    {'flag': 'capital_led', 'code': 'C', 'text': 'Capital-led: capital spending is more than twice stock pay, so the shortfall is mostly investment.'}, \
    {'flag': 'one_off_years', 'code': 'O', 'text': 'Inventory, lending or a discontinued business moved operating cash flow by more than a quarter of revenue in at least one year. The company page shows P1 with and without those years.'}, \
    {'flag': 'latest_is_fiscal_year', 'code': 'F', 'text': 'The latest fiscal year stands in for the latest 12 months, because the quarterly data is unusable or there is no later quarter.'}, \
    {'flag': 'no_cost_line', 'code': 'N', 'text': 'The cost line cannot be built from the filing tags, so there is no P2b and no screen score. The company has P1 alone and is unranked.'}, \
    {'flag': 'capex_missing', 'code': 'X', 'text': 'No capital spending tag in at least one year; that year counts capital spending as zero.'}, \
    {'flag': 'gap_years', 'code': 'G', 'text': 'At least one fiscal year is missing between the first and last year.'}, \
    {'flag': 'revenue_jump', 'code': 'J', 'text': 'Revenue more than tripled in one year, which often marks a merger or a change of reporting entity.'}, \
    {'flag': 'share_count_jump', 'code': 'S', 'text': 'The share count jumps in one year (a stock split, or a conversion at listing). Share counts are not adjusted.'}, \
    {'flag': 'no_insider_filings', 'code': 'I', 'text': 'No insider transactions in the SEC data sets for the five years. Foreign companies have not had to file them.'} \
]


#
# Formatting
#


# Format a number with thousands separators
function tiNumber(value, digits):
    parts = stringSplit(numberToFixed(mathAbs(value), digits), '.')
    whole = arrayGet(parts, 0)
    groups = ''
    while stringLength(whole) > 3:
        groups = ',' + stringSlice(whole, stringLength(whole) - 3) + groups
        whole = stringSlice(whole, 0, stringLength(whole) - 3)
    endwhile
    return if(value < 0, '-', '') + whole + groups + if(digits > 0, '.' + arrayGet(parts, 1), '')
endfunction


# Format dollars as millions - missing is "n/a"
function tiMoney(value):
    if value == null:
        return 'n/a'
    endif
    return if(value < 0, '-', '') + '$' + tiNumber(mathAbs(value) / 1000000, 0) + 'M'
endfunction


# Format dollars at their own scale - billions, millions or thousands - for the insider tables
function tiDollars(value):
    amount = mathAbs(value)
    sign = if(value < 0, '-', '')
    if amount >= 1000000000:
        return sign + '$' + tiNumber(amount / 1000000000, 1) + 'B'
    elif amount >= 1000000:
        return sign + '$' + tiNumber(amount / 1000000, 1) + 'M'
    endif
    return if(amount > 0, sign + '$' + tiNumber(amount / 1000, 0) + 'K', '$0')
endfunction


# Format a multiple, for example sales as a multiple of grants - missing is "n/a"
function tiTimes(value):
    return if(value != null, numberToFixed(value, 1) + 'x', 'n/a')
endfunction


# Format dollars as billions
function tiBillions(value):
    return if(value < 0, '-', '') + '$' + tiNumber(mathAbs(value) / 1000000000, 1) + 'B'
endfunction


# Format a ratio as a percent - missing is "n/a"
function tiPercent(value):
    return if(value != null, numberToFixed(value * 100, 1) + '%', 'n/a')
endfunction


# Make text that does not wrap in a table cell: non-breaking hyphens and spaces
function tiNoWrap(text):
    return stringReplace(stringReplace(text, '-', stringFromCharCode(8209)), ' ', stringFromCharCode(160))
endfunction


# Format a range of years so that it does not wrap
function tiYears(firstYear, lastYear):
    return tiNoWrap(firstYear + '-' + lastYear)
endfunction


# Format a score - missing is "n/a"
function tiScore(value):
    return if(value != null, numberToFixed(value, 1), 'n/a')
endfunction


# Create a Markdown table's lines. Each column's alignment is "l" or "r".
function tiTable(headers, aligns, rows):
    seps = []
    for align in aligns:
        arrayPush(seps, if(align == 'r', '--:', ':--'))
    endfor
    lines = ['| ' + arrayJoin(headers, ' | ') + ' |', '| ' + arrayJoin(seps, ' | ') + ' |']
    for row in rows:
        arrayPush(lines, '| ' + arrayJoin(row, ' | ') + ' |')
    endfor
    return lines
endfunction


# Get the URL of an SEC filing's index page
function tiFilingURL(cik, accn):
    return 'https://www.sec.gov/Archives/edgar/data/' + cik + '/' + stringReplace(accn, '-', '') + '/' + accn + '-index.htm'
endfunction


# Format a sourced figure as a link to its SEC filing - missing is "n/a"
function tiFact(cik, fact):
    if fact == null:
        return 'n/a'
    endif
    return '[' + tiMoney(objectGet(fact, 'v')) + '](' + tiFilingURL(cik, objectGet(fact, 'accn')) + ')'
endfunction


# Get a list item by name
function tiFind(items, name):
    for item in items:
        if objectGet(item, 'name') == name:
            return item
        endif
    endfor
    return null
endfunction


# Get a row's note codes
function tiRowNotes(row):
    flags = objectGet(row, 'flags')
    codes = []
    for note in tiNotes:
        flag = objectGet(note, 'flag')
        if arrayIndexOf(flags, flag) != -1 || (flag == 'capital_led' && objectGet(row, 'capitalLed')):
            arrayPush(codes, objectGet(note, 'code'))
        endif
    endfor
    return arrayJoin(codes, ' ')
endfunction


#
# The index page
#


function tiIndexPage(args, meta, index):
    type = objectGet(args, 'type')
    sort = objectGet(args, 'sort')
    sic = objectGet(args, 'sic')
    find = objectGet(args, 'find')
    funnel = objectGet(meta, 'funnel')
    thresholds = objectGet(meta, 'thresholds')
    line = tiPercent(objectGet(thresholds, 'meaningful_margin'))
    companies = if(index != null, objectGet(index, 'companies'), [])

    # Render the introduction and what a high rank can mean for a shareholder
    totals = objectGet(meta, 'totals')
    screened = objectGet(totals, 'screened')
    rest = objectGet(totals, 'notCapitalLed')
    count = objectGet(screened, 'companies')
    persistence = objectGet(meta, 'persistence')
    bought = objectGet(objectGet(meta, 'buybackShares'), 'notCapitalLed')
    documentSetTitle(tiTitle)
    markdownPrint( \
        '', \
        '# ' + tiTitle, \
        '', \
        'Large, growing companies whose revenue growth has not become meaningful cash for outside owners, because the cash', \
        'goes out as stock pay. Owner cash is free cash flow less stock-based compensation; "meaningful" is ' + line + ' of revenue.', \
        'Of ' + tiNumber(objectGet(funnel, 'inFile'), 0) + ' companies in the SEC data, ' + count + ' pass the screen and ' + \
            objectGet(funnel, 'ranked') + ' are ranked. ' + argsLink(tiArguments, 'How it is computed', {'page': 'method'}, true, argsTopHeaderId) + '.', \
        '', \
        '## What a high rank can mean for a shareholder', \
        '', \
        '**The headline.** A company with no owner cash cannot be valued on what it earns for its owners. It is valued on revenue', \
        'growth, and on profit measures that leave stock pay out. Where that revenue is held up by spending that has to go on,', \
        'such as a large sales force, a valuation on owner cash would be far lower. At the higher valuation its insiders are', \
        'granted shares, and can sell them, every year. The view of this index is that at some companies this is the point: owner', \
        'cash is kept near zero so that the company is never valued on it, while insiders turn grants into cash at the price that', \
        'results. Shareholders who take "investing in growth" on trust bear the cost. The numbers cannot say at which companies', \
        'this is deliberate: a real bet on growth looks the same until it pays off.', \
        '', \
        '**The three signs.** The index looks for three things together, each one visible in the filings. A real growth bet', \
        'loses them in time: owner cash appears as growth slows, costs fall against revenue, and insiders keep what they are granted.', \
        '', \
        '1. **Owner cash that stays near zero (P1).** Together the ' + count + ' companies here recorded ' + \
            tiBillions(objectGet(screened, 'cumSbc')) + ' of stock pay against ' + tiBillions(objectGet(screened, 'cumFcf')) + \
            ' of free cash flow;', \
        '   leaving out the capital-led companies, ' + tiBillions(objectGet(rest, 'cumSbc')) + ' against ' + \
            tiBillions(objectGet(rest, 'cumFcf')) + '. At ' + objectGet(persistence, 'fivePlus') + ' of the ' + count + \
            ', owner cash has been under ' + line + ' of revenue for five or more fiscal years running.', \
        '2. **Revenue held up by costs.** Hiring in sales, marketing and development can absorb whatever growth brings in. At ' + \
            objectGet(objectGet(meta, 'cost'), 'allGross') + ' of the ' + objectGet(funnel, 'ranked') + ' ranked companies,', \
        '   operating costs took all of gross profit or more in the latest year; ' + objectGet(objectGet(meta, 'cost'), 'full') + \
            ' kept them flat or rising as a share of revenue over five years. Cash that does arrive can go to buying back the', \
        '   shares just granted: of the ' + objectGet(bought, 'companies') + ' that bought back shares over five years and whose share count can', \
        '   be followed, the count still rose at ' + objectGet(bought, 'rose') + ', after ' + tiDollars(objectGet(bought, 'spentRose')) + \
            " spent on buybacks and employees' vesting taxes.", \
        tiInsiderLines(meta), \
        '', \
        '**What it costs a shareholder.** Each share owns a smaller part of a company that produces no cash for its owners, at a', \
        'price that cannot be checked against what it earns. A falling share price makes it worse: the same pay takes more shares.', \
        '', \
        "**What a rank does not prove.** A rank measures a pattern. It is not a finding about any one company's purpose, and not", \
        'a forecast that its shares will fall. ' + objectGet(objectGet(meta, 'latest'), 'cleared') + ' of the ' + count + \
            ' had meaningful owner cash in their latest 12 months, and ' + \
            (count - objectGet(rest, 'companies')) + ' are capital-led: their', \
        'shortfall is mostly investment. The figures in the second and third signs leave the capital-led companies out. Each', \
        'company page shows which way its own numbers point, and what cuts the other way. ' + \
            argsLink(tiArguments, 'Group totals', {'page': 'totals'}, true, argsTopHeaderId) + ' has every figure, with the', \
        'cash-generative companies beside them as a baseline.', \
        '', \
        '## The index' \
    )

    # Filter the companies
    rows = []
    findLower = if(find != null, stringLower(find))
    for company in companies:
        ticker = objectGet(company, 'ticker')
        isType = type == 'all' || objectGet(company, 'type') == type
        isIndustry = sic == null || objectGet(company, 'sic') == sic
        isFound = findLower == null || stringIndexOf(stringLower(objectGet(company, 'name')), findLower) != -1 || \
            (ticker != null && stringLower(ticker) == findLower)
        if isType && isIndustry && isFound:
            arrayPush(rows, company)
        endif
    endfor

    # Sort the companies - the data file is in rank order
    sortModel = tiFind(tiSorts, sort)
    if sortModel != null && objectHas(sortModel, 'field'):
        arraySort(rows, systemPartial(tiCompareRows, objectGet(sortModel, 'field'), objectGet(sortModel, 'desc')))
    endif

    # Render the type, sort, industry and find controls
    types = objectGet(meta, 'types')
    typeLinks = []
    for typeModel in tiTypes:
        typeName = objectGet(typeModel, 'name')
        typeTitle = objectGet(typeModel, 'title') + ' (' + objectGet(types, typeName, 0) + ')'
        arrayPush(typeLinks, if(typeName == type, typeTitle, argsLink(tiArguments, typeTitle, {'type': typeName, 'all': false})))
    endfor
    allTitle = 'All (' + tiNumber(objectGet(funnel, 'growth'), 0) + ')'
    arrayPush(typeLinks, if(type == 'all', allTitle, argsLink(tiArguments, allTitle, {'type': 'all', 'all': false})))
    sortLinks = []
    for sortItem in tiSorts:
        sortName = objectGet(sortItem, 'name')
        sortTitle = objectGet(sortItem, 'title')
        arrayPush(sortLinks, if(sortName == sort, sortTitle, argsLink(tiArguments, sortTitle, {'sort': sortName})))
    endfor
    typeModel = tiFind(tiTypes, type)
    controls = ['**Show:** ' + arrayJoin(typeLinks, ' | '), '**Sort:** ' + arrayJoin(sortLinks, ' | ')]
    if sic != null:
        arrayPush(controls, '**Industry:** SIC code ' + sic + ' (' + argsLink(tiArguments, 'all industries', {'sic': null}) + ')')
    endif
    markdownPrint( \
        '', \
        arrayJoin(controls, ' \\\n'), \
        '', \
        if(typeModel != null, '*' + objectGet(typeModel, 'title') + ':* ' + objectGet(typeModel, 'text'), '*All companies that pass the basic tests.*') \
    )
    elementModelRender({'html': 'p', 'elem': [ \
        {'html': 'b', 'elem': {'text': 'Find a company or ticker: '}}, \
        formsTextElements('tiFind', if(find != null, find, ''), 30, tiOnFind), \
        {'text': ' '}, \
        formsLinkButtonElements('Find', tiOnFind), \
        if(find != null, [{'text': ' | '}, formsLinkElements('Clear', argsURL(tiArguments, {'find': null}))], []) \
    ]})

    # Render the table
    count = arrayLength(rows)
    limit = if(objectGet(args, 'all') || count <= tiRowLimit, count, tiRowLimit)
    showType = type == 'all'
    tableRows = []
    for row, ixRow in rows:
        if ixRow >= limit:
            break
        endif
        rank = objectGet(row, 'rank')
        threeRank = objectGet(row, 'threeRank')
        rowType = tiFind(tiTypes, objectGet(row, 'type'))
        tableRow = [ \
            if(threeRank != null, '' + threeRank, ''), \
            argsLink(tiArguments, objectGet(row, 'name'), {'page': 'company', 'cik': objectGet(row, 'cik')}, true, argsTopHeaderId), \
            markdownEscape(objectGet(row, 'ticker', '') || ''), \
            tiScore(objectGet(row, 'threeScore')), \
            tiScore(objectGet(row, 'p1')), \
            tiScore(objectGet(row, 'costs')), \
            tiScore(objectGet(row, 'p3')), \
            tiScore(objectGet(row, 'screenScore')) + if(rank != null, ' (' + rank + ')', ''), \
            tiPercent(objectGet(row, 'cumMargin')), \
            tiPercent(objectGet(row, 'latestMargin')), \
            tiPercent(objectGet(row, 'sbcRevenue')), \
            if(objectGet(row, 'insiderSales') != null, tiDollars(objectGet(row, 'insiderSales')), 'n/a'), \
            tiTimes(objectGet(row, 'salesToGrants')), \
            tiYears(objectGet(row, 'firstYear'), objectGet(row, 'lastYear')), \
            tiRowNotes(row) \
        ]
        if showType:
            arrayPush(tableRow, objectGet(rowType, 'title'))
        endif
        arrayPush(tableRows, tableRow)
    endfor
    headers = ['Rank', 'Company', 'Ticker', 'Three signs (75)', 'Owner cash, P1 (25)', 'Costs (25)', 'Insiders, P3 (25)', \
        'Screen score (50) and rank', \
        'Cumulative owner-cash margin', 'Latest owner-cash margin', 'Stock pay / revenue', 'Insider sales', \
        'Insider sales / grants', 'Years', 'Notes']
    aligns = ['r', 'l', 'l', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'l', 'l']
    if showType:
        arrayPush(headers, 'Type')
        arrayPush(aligns, 'l')
    endif
    if count == 0:
        markdownPrint('', 'No companies match.')
    else:
        markdownPrint('', tiTable(headers, aligns, tableRows))
        if limit < count:
            markdownPrint('', 'Showing ' + limit + ' of ' + tiNumber(count, 0) + ' companies. ' + argsLink(tiArguments, 'Show all', {'all': true}))
        endif
    endif

    # Render the notes legend
    sensitivity = objectGet(meta, 'sensitivity')
    changesKey = tiChangesKey(meta)
    moved = 0
    for entry in sensitivity:
        moved = moved + if(arrayLength(objectGet(entry, changesKey)), 1, 0)
    endfor
    markdownPrint( \
        '', \
        '**Rank** is by the three-signs score, among the companies that pass the screen and have all three pillars. Unranked', \
        'companies are listed for comparison only. **Cumulative** covers every fiscal year shown; **latest** is the latest 12 months.', \
        '', \
        '**The three-signs score is out of 75.** It is P1 + (P1 / 25) x (costs + P3): costs and insider selling count only to', \
        'the extent owners are getting no cash. The costs sign is half whether operating costs fell against revenue (P2b) and', \
        'half how much of gross profit they take. The score is provisional: the costs level is new, and insider grants are valued', \
        'at the full price of the shares they cover, which understates how much of their grants insiders sold.', \
        '**Insider sales** are open-market sales by officers and directors over five calendar years, and **sales / grants**', \
        'compares them with the shares and options granted over the same years; each company page has the detail.', \
        '', \
        "**The screen score is out of 50**, and is the agreed definition's whole-market score: P1 + (P1 / 25) x (P2b scaled to 25).", \
        'Its rank is in brackets. The full score of the definition, out of 100, also needs headcount and earnings-release framing', \
        'for the top 25; those need hand-checked data and are not measured. The three scores must not be compared with each other.', \
        '', \
        '**Neighbouring ranks are close.** Moving one threshold of the definition by a fifth changes the top ten in ' + moved + \
            ' of ' + arrayLength(sensitivity) + ' tests.', \
        'Read a rank as a rough position, not a precise one. ' + argsLink(tiArguments, 'Data and limits', {'page': 'data'}, true, argsTopHeaderId) + \
            ' lists every change.', \
        '', \
        '**Notes**', \
        '' \
    )
    for note in tiNotes:
        markdownPrint('- **' + objectGet(note, 'code') + '** - ' + objectGet(note, 'text'))
    endfor
endfunction


# Get the sensitivity report's changes key for the index's default order: the three-signs ranks when the build has
# insider data, else the screen ranks
function tiChangesKey(meta):
    return if(objectGet(meta, 'insider') != null, 'changesThree', 'changes')
endfunction


# The number of index table rows shown before "Show all"
tiRowLimit = 100


# Compare two index rows by a field
function tiCompareRows(field, desc, rowA, rowB):
    compare = systemCompare(objectGet(rowA, field), objectGet(rowB, field))
    return if(desc, -compare, compare)
endfunction


# The find text input's on-enter handler and the find button's on-click handler
function tiOnFind():
    find = stringTrim(documentInputValue('tiFind'))
    windowSetLocation(argsURL(tiArguments, {'find': if(find != '', find), 'all': false}))
endfunction


#
# The company page
#


function tiCompanyPage(args, meta, cik, company):
    if company == null:
        documentSetTitle(tiTitle)
        markdownPrint('', '# ' + tiTitle, '', 'Unknown company. Only companies that pass the basic tests have a page.')
        return
    endif
    row = objectGet(company, 'row')
    name = objectGet(row, 'name')
    type = tiFind(tiTypes, objectGet(row, 'type'))
    sic = objectGet(row, 'sic')
    ticker = objectGet(row, 'ticker')

    # Render the header
    documentSetTitle(name + ' - ' + tiTitle)
    formerNames = objectGet(company, 'formerNames')
    header = []
    if ticker != null:
        exchange = objectGet(row, 'exchange')
        arrayPush(header, '**Ticker:** ' + markdownEscape(ticker) + if(exchange != null, ' (' + markdownEscape(exchange) + ')', ''))
    endif
    arrayPush(header, '**SEC filings:** [CIK ' + cik + '](https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=' + cik + '&type=10-K)')
    if sic != null:
        arrayPush(header, '**Industry:** ' + markdownEscape(objectGet(row, 'sicDescription') || 'SIC code') + ' (' + \
            argsLink(tiArguments, 'SIC ' + sic, {'page': 'index', 'sic': sic, 'type': 'all'}, true, argsTopHeaderId) + ')')
    endif
    if arrayLength(formerNames):
        arrayPush(header, '**Formerly:** ' + markdownEscape(arrayJoin(formerNames, '; ')))
    endif
    arrayPush(header, '**Type:** ' + objectGet(type, 'title') + '. ' + objectGet(type, 'text') + \
        if(objectGet(row, 'excluded') != null, ' This company is classed as a ' + objectGet(row, 'excluded') + '.', ''))
    markdownPrint( \
        '', \
        '# ' + markdownEscape(name), \
        '', \
        arrayJoin(header, ' \\\n'), \
        '', \
        arrayJoin(objectGet(company, 'summary'), ' ') \
    )

    # A company in an excluded industry is not scored
    if objectGet(row, 'excluded') != null:
        markdownPrint( \
            '', \
            '**Not scored.** The index leaves this industry out, because its cash flows include customer money, loans, property', \
            'or research spending that make free cash flow mean something different. The figures below are for reference only.' \
        )
    else:
        tiCompanyScore(meta, cik, company)
    endif
    tiCompanyInsiders(args, meta, cik, company)
    tiCompanyYears(meta, cik, company)
endfunction


# Render a company's "what cuts the other way" and screen score sections
function tiCompanyScore(meta, cik, company):
    row = objectGet(company, 'row')
    thresholds = objectGet(meta, 'thresholds')
    line = tiPercent(objectGet(thresholds, 'meaningful_margin'))
    rank = objectGet(row, 'rank')
    isTTM = objectGet(row, 'latestBasis') == 'ttm'

    # Render the three signs for this company
    markdownPrint( \
        '', \
        '## Which way the numbers point', \
        '', \
        tiTable(['Sign', 'A growth bet paying off', 'A treadmill', 'This company'], ['l', 'l', 'l', 'l'], tiCompanySigns(meta, company)) \
    )

    # Render what cuts the other way
    otherWay = objectGet(company, 'otherWay')
    markdownPrint('', '## What cuts the other way', '')
    if arrayLength(otherWay):
        for item in otherWay:
            markdownPrint('- ' + objectGet(item, 'text'))
        endfor
    else:
        markdownPrint('Nothing in the numbers the index uses. Stated targets and one-off events are not yet reviewed by hand.')
    endif

    # Render the three-signs score
    p1 = objectGet(row, 'p1')
    p2b = objectGet(row, 'p2b')
    p3 = objectGet(row, 'p3')
    costs = objectGet(row, 'costs')
    screenScore = objectGet(row, 'screenScore')
    threeScore = objectGet(row, 'threeScore')
    threeRank = objectGet(row, 'threeRank')
    funnel = objectGet(meta, 'funnel')
    markdownPrint( \
        '', \
        '## Three-signs score: ' + if(threeScore != null, tiScore(threeScore) + ' of 75', 'not scored') + \
            if(threeRank != null, ' (rank ' + threeRank + ' of ' + objectGet(funnel, 'rankedThree') + ')', if(threeScore != null, ' (unranked)', '')), \
        '', \
        tiTable(['Sign', 'Points'], ['l', 'r'], [ \
            ['Owner cash that stays near zero (P1)', tiScore(p1) + ' of 25'], \
            ['Revenue held up by costs', if(costs != null, tiScore(costs) + ' of 25', 'cannot be built')], \
            ['Insiders who are granted shares and sell them (P3)', if(p3 != null, tiScore(p3) + ' of 25', \
                if(objectGet(meta, 'insider') != null, 'cannot be built', 'not measured in this build'))] \
        ]), \
        '', \
        if(threeScore != null, \
            'P1 + (P1 / 25) x (costs + P3) = ' + tiScore(p1) + ' + (' + tiScore(p1) + ' / 25) x (' + tiScore(costs) + ' + ' + \
                tiScore(p3) + ') = ' + tiScore(threeScore) + '. Costs and insider selling count only to the extent owners are getting no cash.', \
            'The score needs all three signs.'), \
        'The score is provisional: the costs level and P3 are new measures. Insider grants and sales are set out further down.' \
    )
    if threeRank == null && threeScore != null:
        markdownPrint('', 'The company is unranked because it did not pass the screen (see its type above). Its score is shown for comparison.')
    endif

    # Render P1
    markdownPrint( \
        '', \
        '### Owner cash that stays near zero (P1): ' + tiScore(p1) + ' of 25', \
        '', \
        tiTable(['Part', 'Input', 'Points'], ['l', 'r', 'r'], [ \
            ['Years with owner cash under ' + line + ' of revenue', objectGet(row, 'lowYears') + ' of ' + objectGet(row, 'years'), \
                tiScore(objectGet(row, 'p1Years')) + ' of 10'], \
            ['Cumulative owner-cash margin, ' + tiYears(objectGet(row, 'firstYear'), objectGet(row, 'lastYear')), \
                tiPercent(objectGet(row, 'cumMargin')), tiScore(objectGet(row, 'p1Cum')) + ' of 8'], \
            [if(isTTM, 'Owner-cash margin, 12 months to ', 'Owner-cash margin, fiscal year to ') + tiNoWrap(objectGet(row, 'latestEnd')), \
                tiPercent(objectGet(row, 'latestMargin')), tiScore(objectGet(row, 'p1Latest')) + ' of 7'] \
        ]) \
    )
    if !isTTM:
        markdownPrint('', 'The latest fiscal year stands in for the latest 12 months: ' + objectGet(company, 'ttmReason') + '.')
    endif
    if objectGet(row, 'p1Ex') != null:
        markdownPrint( \
            '', \
            'Without the years marked "one-off" below, P1 is ' + tiScore(objectGet(row, 'p1Ex')) + \
                ' and the cumulative owner-cash margin is ' + tiPercent(objectGet(row, 'cumMarginEx')) + '.' \
        )
    endif

    # Render the costs sign
    cost = objectGet(company, 'cost')
    markdownPrint('', '### Revenue held up by costs: ' + if(costs != null, tiScore(costs) + ' of 25', 'cannot be built'), '')
    if cost != null:
        change = objectGet(cost, 'change')
        markdownPrint( \
            'Operating expenses excluding cost of revenue (' + objectGet(cost, 'methodText') + ') were ' + \
                tiPercent(objectGet(cost, 'firstRatio')) + ' of revenue in ' + objectGet(cost, 'firstYear') + ' and ' + \
                tiPercent(objectGet(cost, 'lastRatio')) + ' in ' + objectGet(cost, 'lastYear') + ': a change of ' + \
                if(change > 0, '+', '') + numberToFixed(change, 1) + ' points.', \
            'Sources: ' + tiFactLinks(cik, objectGet(cost, 'firstFacts')) + ' (' + objectGet(cost, 'firstYear') + '), ' + \
                tiFactLinks(cik, objectGet(cost, 'lastFacts')) + ' (' + objectGet(cost, 'lastYear') + ').', \
            '', \
            '- **Change (P2b): ' + tiScore(p2b) + ' of 13**, which counts as ' + tiScore(objectGet(row, 'costsChange')) + \
                ' of 12.5 here. Flat or rising costs score in full; a fall of ' + objectGet(thresholds, 'p2b_zero_drop') + \
                ' points of revenue scores 0.', \
            '- **Level: ' + tiScore(objectGet(row, 'costsLevel')) + ' of 12.5.** In ' + objectGet(cost, 'lastYear') + \
                ' these costs took ' + if(objectGet(row, 'costLevel') != null, tiPercent(objectGet(row, 'costLevel')) + ' of gross profit', \
                'more than all of gross profit, which was not positive') + '. ' + \
                tiPercent(objectGet(thresholds, 'cost_level_zero')) + ' scores 0; ' + \
                tiPercent(objectGet(thresholds, 'cost_level_full')) + ' or more scores in full.' \
        )
    else:
        markdownPrint( \
            'The filings do not tag gross profit, operating income, total costs and cost of revenue consistently enough to build', \
            'the cost line the same way in both years. Missing is not treated as zero, so the company has P1 alone.' \
        )
    endif

    # Render the definition's screen score
    markdownPrint( \
        '', \
        '### Screen score: ' + if(screenScore != null, tiScore(screenScore) + ' of 50', 'not scored') + \
            if(rank != null, ' (rank ' + rank + ' of ' + objectGet(funnel, 'ranked') + ')', ' (unranked)'), \
        '', \
        "The agreed definition's whole-market score, which leaves insiders out: P1 + (P1 / 25) x (P2b x 25 / 13)" + \
            if(screenScore != null, ' = ' + tiScore(p1) + ' + (' + tiScore(p1) + ' / 25) x ' + tiScore(p2b * 25 / 13) + ' = ' + \
                tiScore(screenScore), '') + '.', \
        "The definition's full score, out of 100, also needs gross profit per employee (P2a) and the framing of earnings", \
        'releases (P4). Those need hand-checked data and are not measured for any company.' \
    )
endfunction


# Get the five calendar years of the insider summary, for example "2021-2025"
function tiFiveYears(meta):
    lastYear = numberParseInt(stringSlice(objectGet(meta, 'dataDate'), 0, 4)) - 1
    return tiYears('' + (lastYear - objectGet(objectGet(meta, 'thresholds'), 'p3_years') + 1), '' + lastYear)
endfunction


# The kinds of operating spending reported beside the cost line
tiSpending = [['sm', 'sales and marketing'], ['rnd', 'research and development'], ['ga', 'general and administrative']]


# Get the rows of a company's "which way the numbers point" table: what each sign looks like for a growth bet that
# is paying off and for a treadmill, and this company's own figures
function tiCompanySigns(meta, company):
    row = objectGet(company, 'row')
    insider = objectGet(company, 'insider')
    line = tiPercent(objectGet(objectGet(meta, 'thresholds'), 'meaningful_margin'))
    fiveYears = tiFiveYears(meta)
    lowRun = objectGet(row, 'lowRun')

    # Owner cash
    ownerCash = 'Under ' + line + ' of revenue in ' + objectGet(row, 'lowYears') + ' of ' + objectGet(row, 'years') + ' years' + \
        if(lowRun > 0, ', and for the latest ' + lowRun + ' running', '; above it in the latest fiscal year') + '. ' + \
        tiPercent(objectGet(row, 'latestMargin')) + if(objectGet(row, 'latestBasis') == 'ttm', ' in the latest 12 months.', ' in the latest fiscal year.')

    # Costs, and the kinds of spending the company tags
    cost = objectGet(company, 'cost')
    costs = 'n/a: the cost line cannot be built'
    if cost != null:
        costLevel = objectGet(row, 'costLevel')
        costs = tiPercent(objectGet(cost, 'firstRatio')) + ' of revenue in ' + objectGet(cost, 'firstYear') + ', ' + \
            tiPercent(objectGet(cost, 'lastRatio')) + ' in ' + objectGet(cost, 'lastYear') + \
            if(costLevel != null, ', when they took ' + tiPercent(costLevel) + ' of gross profit', '')
        spending = objectGet(company, 'spending')
        for kind in tiSpending:
            item = objectGet(spending, arrayGet(kind, 0))
            if item != null:
                costs = costs + '; ' + arrayGet(kind, 1) + ' ' + tiPercent(objectGet(item, 'firstRatio')) + ' to ' + \
                    tiPercent(objectGet(item, 'lastRatio'))
            endif
        endfor
    endif
    rows = [ \
        ['Owner cash as the company grows', 'Appears', 'Stays near zero', ownerCash], \
        ['Operating costs against revenue, over five years', 'Fall, and leave part of gross profit', \
            'Keep pace or rise, and take all of gross profit', costs] \
    ]

    # Insiders, where the build has them
    if objectGet(meta, 'insider') != null:
        selling = 'n/a: no insider transactions in the SEC data sets'
        taking = 'n/a'
        if insider != null:
            low = objectGet(insider, 'salesToGrants')
            high = objectGet(insider, 'salesToStockGrants')
            options = objectGet(insider, 'optionGrants')
            selling = 'Sold ' + tiDollars(objectGet(insider, 'sales')) + '; granted stock worth ' + tiDollars(objectGet(insider, 'grants')) + \
                if(options > 0, ' and options over shares worth ' + tiDollars(options), '') + ': ' + \
                if(low == null, objectGet(insider, 'ratioReason'), \
                    if(high != null && tiTimes(high) != tiTimes(low), 'between ' + tiTimes(low) + ' and ' + tiTimes(high), tiTimes(low)) + \
                    ' what they were granted')
            taking = 'Owner cash ' + tiDollars(objectGet(row, 'ownerCashFive')) + '; insider sales ' + tiDollars(objectGet(insider, 'sales'))
        endif
        arrayPush(rows, ['Insiders, ' + fiveYears, 'Keep what they are granted', 'Sell it', selling])
        arrayPush(rows, ['Owner cash against insider sales, ' + fiveYears, 'Owners get more than insiders take out', \
            'Insiders take out more', taking])
    endif

    # The share count against buybacks
    shareGrowth = objectGet(row, 'shareGrowthFive')
    buybacks = objectGet(row, 'buybacksFive') + objectGet(row, 'withholdingFive')
    arrayPush(rows, ['Share count, ' + fiveYears, 'Falls when the company buys back shares', 'Holds or rises despite buybacks', \
        if(shareGrowth == null, 'n/a: the share count cannot be followed', \
            if(shareGrowth > 0, 'Rose ', 'Fell ') + tiPercent(mathAbs(shareGrowth)) + ' a year') + \
        if(buybacks > 0, ', after ' + tiDollars(buybacks) + " of buybacks and employees' vesting taxes", '; no buybacks')])
    return rows
endfunction


# Render a company's insiders: the P3 score, the yearly grants and sales, and the largest sellers
function tiCompanyInsiders(args, meta, cik, company):
    row = objectGet(company, 'row')
    insider = objectGet(company, 'insider')
    insiderMeta = objectGet(meta, 'insider')
    if insiderMeta == null:
        return
    endif
    yearsText = tiYears(objectGet(insiderMeta, 'firstYear'), objectGet(insiderMeta, 'lastYear'))
    markdownPrint('', '## Insiders: grants and sales, ' + yearsText, '')
    if insider == null:
        markdownPrint('No officer or director of this company reported a transaction in the SEC insider data sets for these years.', \
            'Foreign companies have not had to file them.')
        return
    endif

    # Render the summary and P3
    thresholds = objectGet(meta, 'thresholds')
    ratio = objectGet(insider, 'salesToGrants')
    markdownPrint( \
        objectGet(insider, 'insiders') + ' officers and directors reported transactions, and ' + objectGet(insider, 'sellers') + \
            ' of them sold shares on the open market.', \
        'Together they sold ' + tiDollars(objectGet(insider, 'sales')) + ', and were granted shares worth ' + \
            tiDollars(objectGet(insider, 'grants')) + ' and options over shares worth ' + tiDollars(objectGet(insider, 'optionGrants')) + \
            ' at the time.' \
    )
    if objectGet(row, 'p3Years') != null:
        p3 = objectGet(row, 'p3')
        markdownPrint( \
            '', \
            '**P3. Insiders granting and selling: ' + if(p3 != null, tiScore(p3) + ' of 25', 'cannot be built') + '**', \
            '', \
            tiTable(['Part', 'Input', 'Points'], ['l', 'r', 'r'], [ \
                ['Years with both new grants and open-market sales', \
                    objectGet(insider, 'bothYears') + ' of ' + objectGet(thresholds, 'p3_years'), \
                    tiScore(objectGet(row, 'p3Years')) + ' of ' + objectGet(thresholds, 'p3_years_points')], \
                ['Open-market sales as a multiple of grants, counting options at the full price of their shares', \
                    if(ratio != null, tiTimes(ratio), objectGet(insider, 'ratioReason')), \
                    if(objectGet(row, 'p3Ratio') != null, tiScore(objectGet(row, 'p3Ratio')) + ' of ' + \
                        objectGet(thresholds, 'p3_ratio_points'), 'n/a')] \
            ]), \
            '', \
            'P3 is a first, provisional measure. Sales of ' + objectGet(thresholds, 'p3_ratio_zero') + ' times grants score 0; ' + \
                objectGet(thresholds, 'p3_ratio_full') + ' times scores ' + objectGet(thresholds, 'p3_ratio_points') + '.' + \
                if(objectGet(insider, 'salesToStockGrants') != null && objectGet(insider, 'optionGrants') > 0, \
                    ' Counting options as worth nothing, the multiple would be ' + tiTimes(objectGet(insider, 'salesToStockGrants')) + \
                    '; the truth lies between.', '') \
        )
    endif

    # Render the yearly table
    yearRows = []
    for year in objectGet(insider, 'years'):
        arrayPush(yearRows, tiInsiderAmounts(['' + objectGet(year, 'year')], year))
    endfor
    arrayPush(yearRows, tiInsiderAmounts(['**' + yearsText + '**'], insider))
    markdownPrint('', tiTable(arrayExtend(['Year'], tiInsiderHeaders), ['l', 'r', 'r', 'r', 'r', 'r', 'r'], yearRows))

    # Render the insiders' sales beside the company's buybacks, by quarter
    quarters = objectGet(insider, 'quarters')
    if arrayLength(quarters):
        quarterRows = []
        for quarter in quarters:
            arrayPush(quarterRows, [ \
                tiNoWrap(objectGet(quarter, 'start')) + ' to ' + tiNoWrap(objectGet(quarter, 'end')), \
                '[' + tiDollars(objectGet(quarter, 'buybacks')) + '](' + tiFilingURL(cik, objectGet(quarter, 'accn')) + ')', \
                tiDollars(objectGet(quarter, 'sales')) \
            ])
        endfor
        markdownPrint( \
            '', \
            "**Sales beside buybacks.** The filings give the company's buybacks for " + arrayLength(quarters) + \
                ' quarters of these years. It bought back ' + tiDollars(objectGet(insider, 'buybacks')) + ' of shares, in ' + \
                objectGet(insider, 'buybackQuarters') + ' of them.', \
            'Insiders sold ' + tiDollars(objectGet(insider, 'salesInBuybackQuarters')) + ' in those quarters, out of ' + \
                tiDollars(objectGet(insider, 'salesInQuarters')) + ' in all ' + arrayLength(quarters) + '.', \
            'This shows timing only: shares a company buys on the open market cannot be traced to a seller.', \
            '', \
            tiTable(['Quarter', 'The company bought back', 'Insiders sold on the open market'], ['l', 'r', 'r'], quarterRows) \
        )
    else:
        markdownPrint( \
            '', \
            '**Sales beside buybacks.** The filings give no buybacks by quarter for these years. A company that has not bought', \
            'back shares reports none.' \
        )
    endif

    # Render the largest sellers, each linked to their filings
    people = objectGet(insider, 'people')
    personCik = objectGet(args, 'person')
    person = null
    peopleRows = []
    for candidate in people:
        if objectGet(candidate, 'cik') == personCik:
            person = candidate
        endif
        nameLink = argsLink(tiArguments, objectGet(candidate, 'name'), {'person': objectGet(candidate, 'cik')}, false, tiFilingsTitle)
        arrayPush(peopleRows, tiInsiderAmounts([nameLink, markdownEscape(objectGet(candidate, 'title'))], candidate))
    endfor
    if arrayLength(people):
        markdownPrint( \
            '', \
            "**The largest sellers.** Select a name to list that person's filings.", \
            '', \
            tiTable(arrayExtend(['Insider', 'Latest title'], tiInsiderHeaders), ['l', 'l', 'r', 'r', 'r', 'r', 'r', 'r'], peopleRows) \
        )
    endif
    markdownPrint( \
        '', \
        'From the SEC insider filings (Forms 4 and 5) of officers and directors. A sale, purchase or tax withholding is valued at', \
        'the price reported for it. A grant is valued at the market price of the shares it covers on the grant date: a stock award', \
        'at the nearest share price insiders reported, an option at its exercise price. An option is worth less than the shares', \
        'it covers, and a performance award may never vest, so grants are overstated and sales as a multiple of grants are', \
        "understated. Shares held through an outside director's investment fund are left out. Amended filings are not used." \
    )

    # Render the selected person's filings
    if person != null:
        filingRows = []
        for filing in objectGet(person, 'filings'):
            accn = objectGet(filing, 'accn')
            arrayPush(filingRows, tiInsiderAmounts( \
                [tiNoWrap(objectGet(filing, 'filed') || ''), '[' + tiNoWrap(accn) + '](' + tiFilingURL(cik, accn) + ')'], filing))
        endfor
        markdownPrint( \
            '', \
            '### ' + tiFilingsTitle, \
            '', \
            '**' + markdownEscape(objectGet(person, 'name')) + '**, ' + markdownEscape(objectGet(person, 'title')) + '. Each filing opens at the SEC.', \
            '', \
            tiTable(arrayExtend(['Filed', 'Filing'], tiInsiderHeaders), ['l', 'l', 'r', 'r', 'r', 'r', 'r', 'r'], filingRows) \
        )
    endif
endfunction


# The header of a person's filings on the company page
tiFilingsTitle = 'Filings of the selected insider'


# The insider tables' amount columns
tiInsiderHeaders = ['Sold on the open market', 'Stock granted', 'Options granted, at the price of the shares', \
    'Withheld for taxes', 'Sold to the company', 'Bought on the open market']


# Add the insider amount cells to a table row
function tiInsiderAmounts(tableRow, item):
    for amount in ['sales', 'grants', 'optionGrants', 'withheld', 'toIssuer', 'purchases']:
        arrayPush(tableRow, tiDollars(objectGet(item, amount)))
    endfor
    return tableRow
endfunction


# Get the index page's lines on the third sign: what insiders did
function tiInsiderLines(meta):
    insiderMeta = objectGet(meta, 'insider')
    if insiderMeta == null:
        return '3. **Insiders who are granted shares and sell them (P3).** Insider grants and sales are not measured in this build.'
    endif
    group = objectGet(insiderMeta, 'notCapitalLed')
    count = objectGet(group, 'companies')
    baseline = objectGet(insiderMeta, 'cashGenerative')
    return [ \
        '3. **Insiders who are granted shares and sell them (P3).** In ' + \
            tiYears(objectGet(insiderMeta, 'firstYear'), objectGet(insiderMeta, 'lastYear')) + ', the officers and directors of ' + \
            count + ' of these companies sold ' + tiDollars(objectGet(group, 'sales')) + ' of shares on the open market,', \
        '   and were granted shares worth ' + tiDollars(objectGet(group, 'grants')) + ' and options over shares worth ' + \
            tiDollars(objectGet(group, 'optionGrants')) + ' at the time. Over the same years those companies produced ' + \
            tiDollars(objectGet(group, 'ownerCash')) + ' of owner cash.', \
        '   At ' + objectGet(group, 'tookMore') + ' of the ' + count + ', insiders sold more than the business produced for its owners;' + \
            ' among the cash-generative companies it was ' + objectGet(baseline, 'tookMore') + ' of ' + \
            tiNumber(objectGet(baseline, 'companies'), 0) + '.' \
    ]
endfunction


# Render a company's yearly chart and table, and the notes on its data
function tiCompanyYears(meta, cik, company):
    row = objectGet(company, 'row')
    thresholds = objectGet(meta, 'thresholds')

    # Render the yearly chart
    years = objectGet(company, 'years')
    chart = tiYearsChart(years, objectGet(thresholds, 'meaningful_margin'))
    markdownPrint('', '## Year by year', '')
    dataLineChart(objectGet(chart, 'data'), objectGet(chart, 'model'))
    clipped = objectGet(chart, 'clipped')
    markdownPrint(if(arrayLength(clipped), \
        'The chart stops at ' + tiChartLimit + '% above and below zero. Drawn at its edge: ' + arrayJoin(clipped, ', ') + '.', ''))

    # Render the yearly table
    yearRows = []
    for year in years:
        oneOffs = []
        for oneOff in objectGet(year, 'oneOff'):
            arrayPush(oneOffs, objectGet(oneOff, 'cause') + ' ' + tiFact(cik, objectGet(oneOff, 'fact')))
        endfor
        capexFacts = []
        for capexName in ['capexBase', 'capexSoftware']:
            if objectGet(year, capexName) != null:
                arrayPush(capexFacts, tiFact(cik, objectGet(year, capexName)))
            endif
        endfor
        arrayPush(yearRows, [ \
            objectGet(year, 'fy'), \
            tiNoWrap(objectGet(year, 'end')), \
            tiFact(cik, objectGet(year, 'rev')), \
            tiFact(cik, objectGet(year, 'ocf')), \
            if(arrayLength(capexFacts), arrayJoin(capexFacts, ' + '), 'n/a'), \
            tiFact(cik, objectGet(year, 'sbc')), \
            tiMoney(objectGet(year, 'fcf')), \
            tiMoney(objectGet(year, 'ownerCash')), \
            tiPercent(objectGet(year, 'margin')), \
            tiFact(cik, objectGet(year, 'buybacks')), \
            tiFact(cik, objectGet(year, 'dividends')), \
            arrayJoin(oneOffs, ', ') \
        ])
    endfor
    ttm = objectGet(company, 'ttm')
    if ttm != null:
        ttmSources = []
        for accn, ixAccn in objectGet(ttm, 'sources'):
            arrayPush(ttmSources, '[' + (ixAccn + 1) + '](' + tiFilingURL(cik, accn) + ')')
        endfor
        arrayPush(yearRows, [ \
            '**' + tiNoWrap('12 months') + '**', \
            tiNoWrap(objectGet(ttm, 'end')), \
            tiMoney(objectGet(ttm, 'rev')), \
            tiMoney(objectGet(ttm, 'ocf')), \
            tiMoney(objectGet(ttm, 'capex')), \
            tiMoney(objectGet(ttm, 'sbc')), \
            tiMoney(objectGet(ttm, 'fcf')), \
            tiMoney(objectGet(ttm, 'ownerCash')), \
            tiPercent(objectGet(ttm, 'margin')), \
            '', \
            '', \
            'quarterly filings: ' + arrayJoin(ttmSources, ', ') \
        ])
    endif
    markdownPrint( \
        '', \
        tiTable( \
            ['Fiscal year', 'Year end', 'Revenue', 'Operating cash flow', 'Capital spending', 'Stock pay', 'Free cash flow', \
                'Owner cash', 'Owner-cash margin', 'Buybacks', 'Dividends', 'One-off'], \
            ['l', 'l', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'r', 'l'], \
            yearRows \
        ), \
        '', \
        'Every linked figure opens the SEC filing it was taken from; each is the most recently filed value for that year.', \
        'Free cash flow = operating cash flow - capital spending. Owner cash = free cash flow - stock pay.', \
        'The 12-month row is the latest fiscal year, plus the year-to-date period since, less the same period a year earlier.', \
        '"n/a" means the filings have no tagged figure. History starts about 2009.' \
    )

    # Render the share count and data-quality notes
    shareGrowth = objectGet(row, 'shareGrowth')
    markdownPrint( \
        '', \
        '## Notes on the data', \
        '', \
        '- Diluted share count: ' + if(shareGrowth != null, \
            'changed ' + if(shareGrowth > 0, '+', '') + tiPercent(shareGrowth) + ' a year over the period.', \
            'no annual change is shown (' + objectGet(company, 'shareReason') + ').') \
    )
    flags = objectGet(row, 'flags')
    for note in tiNotes:
        flag = objectGet(note, 'flag')
        if arrayIndexOf(flags, flag) != -1 || (flag == 'capital_led' && objectGet(row, 'capitalLed')):
            markdownPrint('- ' + objectGet(note, 'text'))
        endif
    endfor
endfunction


# The percent, above and below zero, at which the yearly chart stops
tiChartLimit = 100


# Create the yearly owner-cash margin chart's data and model. The chart stops at the chart limit, so that one
# extreme year does not flatten the rest. A year beyond the limit is drawn at the limit; "clipped" lists those
# years with their values, for example "2021 (-167%)".
function tiYearsChart(years, meaningfulMargin):
    data = []
    clipped = []
    for year in years:
        margin = objectGet(year, 'margin') * 100
        if mathAbs(margin) > tiChartLimit:
            arrayPush(clipped, objectGet(year, 'fy') + ' (' + numberToFixed(margin, 0) + '%)')
            margin = mathSign(margin) * tiChartLimit
        endif
        arrayPush(data, {'Fiscal year': numberParseInt(objectGet(year, 'fy')), 'Owner-cash margin (%)': margin})
    endfor
    model = { \
        'title': 'Owner cash as a percent of revenue', \
        'width': 720, \
        'height': 300, \
        'x': 'Fiscal year', \
        'y': ['Owner-cash margin (%)'], \
        'precision': 0, \
        'yLines': [{'value': meaningfulMargin * 100, 'label': tiPercent(meaningfulMargin)}] \
    }
    if arrayLength(clipped):
        objectSet(model, 'yMin', -tiChartLimit)
        objectSet(model, 'yMax', tiChartLimit)
    endif
    return {'data': data, 'model': model, 'clipped': clipped}
endfunction


# Format a list of sourced figures as links to their SEC filings
function tiFactLinks(cik, facts):
    links = []
    for fact in facts:
        arrayPush(links, '[' + objectGet(fact, 'tag') + ' ' + tiMoney(objectGet(fact, 'v')) + '](' + tiFilingURL(cik, objectGet(fact, 'accn')) + ')')
    endfor
    return arrayJoin(links, ', ')
endfunction


#
# The group totals page
#


function tiTotalsPage(meta):
    totals = objectGet(meta, 'totals')
    screened = objectGet(totals, 'screened')
    rest = objectGet(totals, 'notCapitalLed')
    latest = objectGet(meta, 'latest')
    cost = objectGet(meta, 'cost')
    count = objectGet(screened, 'companies')
    line = tiPercent(objectGet(objectGet(meta, 'thresholds'), 'meaningful_margin'))

    documentSetTitle('Group totals - ' + tiTitle)
    totalRows = []
    for total in tiTotals:
        key = objectGet(total, 'key')
        arrayPush(totalRows, [objectGet(total, 'title'), tiBillions(objectGet(screened, key)), tiBillions(objectGet(rest, key))])
    endfor
    markdownPrint( \
        '', \
        '# Group totals', \
        '', \
        "The " + count + " companies that pass the screen, added together over each company's own history", \
        '(about 2009 onward). ' + (count - objectGet(rest, 'companies')) + ' of them are capital-led: their capital spending', \
        'is more than twice their stock pay, so their shortfall is mostly investment. The last column leaves them out.', \
        '', \
        tiTable(['', 'All ' + count, 'Without the capital-led (' + objectGet(rest, 'companies') + ')'], ['l', 'r', 'r'], totalRows), \
        '', \
        'Buybacks and dividends are cash paid out, shown for comparison; they are not scored.', \
        tiTotalsBuybackLines(meta), \
        tiTotalsInsiderLines(meta), \
        '', \
        '## Latest 12 months', \
        '', \
        'Of the ' + count + ' companies:', \
        '', \
        '- Owner cash of ' + line + ' of revenue or more: ' + objectGet(latest, 'cleared'), \
        '- Negative owner cash: ' + objectGet(latest, 'negative'), \
        '- The latest fiscal year stands in for the latest 12 months: ' + objectGet(latest, 'fiscalYearBasis'), \
        '', \
        '## Operating costs', \
        '', \
        'Of the ' + count + ' companies, over the latest five fiscal years:', \
        '', \
        '- Flat or rising costs as a share of revenue (full P2b): ' + objectGet(cost, 'full'), \
        '- Costs cut by ' + objectGet(objectGet(meta, 'thresholds'), 'p2b_zero_drop') + ' points of revenue or more (P2b of zero): ' + \
            objectGet(cost, 'zero'), \
        '- No usable cost line (unranked): ' + objectGet(cost, 'missing') \
    )
endfunction


# Get the group totals page's lines on buybacks against the share count
function tiTotalsBuybackLines(meta):
    buybackShares = objectGet(meta, 'buybackShares')
    rows = [ \
        ['Companies that bought back shares, and whose share count can be followed'], ['...where the share count still rose'], \
        ["Spent on buybacks and employees' vesting taxes"], ['...by the companies where the share count still rose'] \
    ]
    for name in ['screened', 'notCapitalLed', 'cashGenerative']:
        group = objectGet(buybackShares, name)
        arrayPush(arrayGet(rows, 0), tiNumber(objectGet(group, 'companies'), 0))
        arrayPush(arrayGet(rows, 1), tiNumber(objectGet(group, 'rose'), 0))
        arrayPush(arrayGet(rows, 2), tiDollars(objectGet(group, 'spent')))
        arrayPush(arrayGet(rows, 3), tiDollars(objectGet(group, 'spentRose')))
    endfor
    return [ \
        '', \
        '## Buybacks against the share count, ' + tiFiveYears(meta), \
        '', \
        'A buyback returns cash to owners only if it leaves fewer shares. Where the share count still rose, the cash went to', \
        'offsetting the shares granted. The count is the diluted weighted average; a company whose count jumps in one year (a', \
        'split, or a conversion at listing) is left out.', \
        '', \
        tiTable(['', 'All', 'Without the capital-led', 'Cash-generative companies'], ['l', 'r', 'r', 'r'], rows) \
    ]
endfunction


# Get the group totals page's insider lines
function tiTotalsInsiderLines(meta):
    insiderMeta = objectGet(meta, 'insider')
    if insiderMeta == null:
        return ''
    endif
    groups = [objectGet(insiderMeta, 'screened'), objectGet(insiderMeta, 'notCapitalLed'), objectGet(insiderMeta, 'cashGenerative')]
    rows = [ \
        ['Companies with insider filings'], ['...where insiders sold more than they were granted'], \
        ['Owner cash those companies produced, same years'], ['...where insiders sold more than that owner cash'] \
    ]
    for header in tiInsiderHeaders:
        arrayPush(rows, [header])
    endfor
    for group in groups:
        arrayPush(arrayGet(rows, 0), tiNumber(objectGet(group, 'companies'), 0))
        arrayPush(arrayGet(rows, 1), tiNumber(objectGet(group, 'soldMore'), 0))
        arrayPush(arrayGet(rows, 2), tiDollars(objectGet(group, 'ownerCash')))
        arrayPush(arrayGet(rows, 3), tiNumber(objectGet(group, 'tookMore'), 0))
        for amount, ixAmount in ['sales', 'grants', 'optionGrants', 'withheld', 'toIssuer', 'purchases']:
            arrayPush(arrayGet(rows, ixAmount + 4), tiDollars(objectGet(group, amount)))
        endfor
    endfor

    # The insiders' sales beside the companies' buybacks, over the quarters for which the filings give buybacks
    quarterRows = [ \
        ["Quarters with the company's buybacks given"], ['...with a buyback'], ['Company buybacks in those quarters'], \
        ['Insider open-market sales in those quarters'], ['...in the quarters with a buyback'] \
    ]
    shares = []
    for group in groups:
        arrayPush(arrayGet(quarterRows, 0), tiNumber(objectGet(group, 'quarters'), 0))
        arrayPush(arrayGet(quarterRows, 1), tiNumber(objectGet(group, 'buybackQuarters'), 0))
        arrayPush(arrayGet(quarterRows, 2), tiDollars(objectGet(group, 'buybacks')))
        arrayPush(arrayGet(quarterRows, 3), tiDollars(objectGet(group, 'salesInQuarters')))
        arrayPush(arrayGet(quarterRows, 4), tiDollars(objectGet(group, 'salesInBuybackQuarters')))
        arrayPush(shares, [ \
            tiPercent(if(objectGet(group, 'quarters'), objectGet(group, 'buybackQuarters') / objectGet(group, 'quarters'))), \
            tiPercent(if(objectGet(group, 'salesInQuarters'), objectGet(group, 'salesInBuybackQuarters') / objectGet(group, 'salesInQuarters'))) \
        ])
    endfor
    return [ \
        '', \
        '## Insiders, ' + tiYears(objectGet(insiderMeta, 'firstYear'), objectGet(insiderMeta, 'lastYear')), \
        '', \
        'What the officers and directors of these companies reported to the SEC over five calendar years. The last column', \
        'is the baseline: the companies that pass the basic tests and do produce meaningful owner cash.', \
        '', \
        tiTable(['', 'All', 'Without the capital-led', 'Cash-generative companies'], ['l', 'r', 'r', 'r'], rows), \
        '', \
        'Grants are valued at the market price of the shares they cover on the grant date. That overstates options, and', \
        'performance awards that may never vest: a single award can dominate the "stock granted" total.', \
        '', \
        '### Sales beside buybacks', \
        '', \
        "Each company's buybacks by quarter, where its filings give them, beside its insiders' open-market sales in the same", \
        'quarter. If insiders sold mostly while their company was buying, the share of their sales that fell in buyback', \
        'quarters would be well above the share of quarters that had a buyback.', \
        '', \
        tiTable(['', 'All', 'Without the capital-led', 'Cash-generative companies'], ['l', 'r', 'r', 'r'], quarterRows), \
        '', \
        'Without the capital-led companies, ' + arrayGet(arrayGet(shares, 1), 0) + ' of quarters had a buyback and ' + \
            arrayGet(arrayGet(shares, 1), 1) + ' of insider sales fell in them. For the cash-generative companies it was ' + \
            arrayGet(arrayGet(shares, 2), 0) + ' and ' + arrayGet(arrayGet(shares, 2), 1) + '.', \
        'This shows timing only: shares a company buys on the open market cannot be traced to a seller.' \
    ]
endfunction


# The group totals rows
tiTotals = [ \
    {'key': 'cumRevenue', 'title': 'Revenue'}, \
    {'key': 'cumFcf', 'title': 'Free cash flow'}, \
    {'key': 'cumSbc', 'title': 'Stock pay'}, \
    {'key': 'cumOwnerCash', 'title': 'Owner cash (free cash flow - stock pay)'}, \
    {'key': 'cumCapex', 'title': 'Capital spending'}, \
    {'key': 'buybacks', 'title': 'Share buybacks'}, \
    {'key': 'withholding', 'title': "Cash paid for employees' vesting taxes"}, \
    {'key': 'dividends', 'title': 'Dividends'} \
]


#
# The threshold explorer page
#


function tiExplorePage(args, meta, index):
    base = objectGet(meta, 'thresholds')
    companies = if(index != null, objectGet(index, 'companies'), [])

    # Compute the explorer thresholds
    thresholds = objectCopy(base)
    controlRows = []
    for model in tiExploreThresholds:
        arg = objectGet(model, 'arg')
        key = objectGet(model, 'key')
        baseValue = objectGet(base, key)
        value = objectGet(args, arg, baseValue)
        objectSet(thresholds, key, value)
        isPercent = objectGet(model, 'percent')
        links = []
        for factor in [0.8, 1, 1.2]:
            linkValue = mathRound(baseValue * factor * 1000000) / 1000000
            linkText = if(factor == 1, 'definition', if(factor < 1, 'a fifth lower', 'a fifth higher'))
            arrayPush(links, if(linkValue == value, linkText, argsLink(tiArguments, linkText, objectNew(arg, if(factor != 1, linkValue)))))
        endfor
        arrayPush(controlRows, [ \
            objectGet(model, 'label'), \
            if(isPercent, tiPercent(baseValue), '' + baseValue), \
            if(isPercent, tiPercent(value), '' + value), \
            arrayJoin(links, ' \\| ') \
        ])
    endfor

    # Re-score and re-rank the companies
    rescored = []
    for company in companies:
        result = tiRescore(company, thresholds)
        if objectGet(result, 'type') == 'stock_pay' && objectGet(result, 'screenScore') != null:
            arrayPush(rescored, result)
        endif
    endfor
    arraySort(rescored, tiCompareRescored)
    tableRows = []
    for result, ixResult in rescored:
        if ixResult >= tiExploreLimit:
            break
        endif
        company = objectGet(result, 'company')
        rank = objectGet(company, 'rank')
        arrayPush(tableRows, [ \
            '' + (ixResult + 1), \
            if(rank != null, '' + rank, 'unranked'), \
            argsLink(tiArguments, objectGet(company, 'name'), {'page': 'company', 'cik': objectGet(company, 'cik')}, true, argsTopHeaderId), \
            tiScore(objectGet(result, 'screenScore')), \
            tiScore(objectGet(company, 'screenScore')), \
            tiScore(objectGet(result, 'p1')), \
            tiScore(objectGet(result, 'p2b')) \
        ])
    endfor

    documentSetTitle('Threshold explorer - ' + tiTitle)
    markdownPrint( \
        '', \
        '# Threshold explorer', \
        '', \
        'The point scales are judgment. This page re-scores every company in your browser with a threshold moved, so you can', \
        "see which ranks depend on it. The published index always uses the definition's values.", \
        argsLink(tiArguments, 'Reset all', {'page': 'explore'}, true, argsTopHeaderId), \
        '', \
        tiTable(['Threshold', 'Definition', 'Now', 'Set to'], ['l', 'r', 'r', 'l'], controlRows), \
        '', \
        '## The top ' + tiExploreLimit + ' at these thresholds', \
        '', \
        arrayLength(rescored) + ' companies pass the screen and are ranked at these thresholds; ' + \
            objectGet(objectGet(meta, 'funnel'), 'ranked') + ' are in the published index.', \
        '', \
        tiTable( \
            ['Rank here', 'Published rank', 'Company', 'Screen score here', 'Published screen score', 'P1 here', 'P2b here'], \
            ['r', 'r', 'l', 'r', 'r', 'r', 'r'], \
            tableRows \
        ), \
        '', \
        'Scores here are computed from rounded yearly margins, so they can differ from the published scores in the last digit.', \
        'The basic tests (revenue, years of data, growth) and the five-year cost window cannot be moved here. The', \
        argsLink(tiArguments, 'data and limits', {'page': 'data'}, true, argsTopHeaderId) + ' page reports how moving each of those changes the top ten.' \
    )
endfunction


# The number of companies the explorer page lists
tiExploreLimit = 25


# Score points linearly between two values, capped at both ends
function tiLin(value, zero, full, points):
    return mathMax(0, mathMin(points, points * (zero - value) / (zero - full)))
endfunction


# Re-score a company at some thresholds
function tiRescore(company, thresholds):
    line = objectGet(thresholds, 'meaningful_margin')
    margins = objectGet(company, 'margins')
    lowYears = 0
    for margin in margins:
        if margin < line:
            lowYears = lowYears + 1
        endif
    endfor
    cumMargin = objectGet(company, 'cumMargin')
    p1 = objectGet(thresholds, 'p1_years_points') * lowYears / arrayLength(margins) + \
        tiLin(cumMargin, objectGet(thresholds, 'p1_cum_zero'), objectGet(thresholds, 'p1_cum_full'), objectGet(thresholds, 'p1_cum_points')) + \
        tiLin(objectGet(company, 'latestMargin'), objectGet(thresholds, 'p1_latest_zero'), objectGet(thresholds, 'p1_latest_full'), \
            objectGet(thresholds, 'p1_latest_points'))

    # P2b and the screen score
    costChange = objectGet(company, 'costChange')
    p2bPoints = objectGet(thresholds, 'p2b_points')
    p2b = if(costChange != null, tiLin(-costChange, objectGet(thresholds, 'p2b_zero_drop'), 0, p2bPoints))
    screenScore = if(p2b != null, p1 + (p1 / 25) * (p2b * 25 / p2bPoints))

    # The company type
    fcf = objectGet(company, 'cumFcf')
    sbc = objectGet(company, 'cumSbc')
    sbcRevenueMin = objectGet(thresholds, 'sbc_revenue_min') * objectGet(company, 'cumRevenue')
    if objectGet(company, 'excluded') != null:
        type = 'excluded'
    elif cumMargin >= line:
        type = 'cash_generative'
    elif fcf >= 0 && sbc >= sbcRevenueMin && sbc >= objectGet(thresholds, 'sbc_fcf_min') * fcf:
        type = 'stock_pay'
    else:
        type = if(fcf < 0, 'cash_burner', 'thin_margin')
    endif

    return {'company': company, 'type': type, 'p1': p1, 'p2b': p2b, 'screenScore': screenScore}
endfunction


# Compare two re-scored companies - by screen score, then name
function tiCompareRescored(resultA, resultB):
    compare = systemCompare(objectGet(resultB, 'screenScore'), objectGet(resultA, 'screenScore'))
    return if(compare != 0, compare, systemCompare(objectGet(objectGet(resultA, 'company'), 'name'), objectGet(objectGet(resultB, 'company'), 'name')))
endfunction


#
# The methodology page
#


function tiMethodPage(meta):
    thresholds = objectGet(meta, 'thresholds')
    funnel = objectGet(meta, 'funnel')
    line = tiPercent(objectGet(thresholds, 'meaningful_margin'))
    exclusions = []
    for exclusion in objectGet(meta, 'sicExclusions'):
        first = objectGet(exclusion, 'first')
        last = objectGet(exclusion, 'last')
        arrayPush(exclusions, objectGet(exclusion, 'group') + ' (' + first + if(last != first, '-' + last, '') + ')')
    endfor
    costMethods = objectGet(meta, 'costMethods')

    documentSetTitle('Methodology - ' + tiTitle)
    markdownPrint( \
        '', \
        '# Methodology', \
        '', \
        '## What the index measures', \
        '', \
        'Mature companies whose revenue growth has not become meaningful cash for outside owners because the cash goes out as', \
        'stock pay. It ranks how owners have been treated. It does not predict share prices, it is not a trading', \
        'recommendation, and it does not measure intent: the view that some companies keep the pattern going on purpose is', \
        "this index's, stated on the index page, and is not a finding about any one company. Paying staff in stock, and", \
        'reporting profit before stock pay, are legal and disclosed.', \
        '', \
        '## Definitions', \
        '', \
        '- **Free cash flow** = operating cash flow - capital spending (including capitalized software).', \
        '- **Stock pay** = stock-based compensation expense.', \
        '- **Owner cash** = free cash flow - stock pay.', \
        '- **Owner-cash margin** = owner cash / revenue.', \
        '- **Meaningful** owner cash is ' + line + ' of revenue or more. It is not zero, so a company cannot pass by a hair.', \
        '', \
        'Annual figures come from the financial data companies file with the SEC. Where a figure was filed more than once,', \
        'the most recently filed value is used. Nothing is estimated; a figure that is not in the filings is shown as "n/a".', \
        '', \
        '## Stage 1: the market screen', \
        '', \
        'Every company in the SEC data is tested. A company is kept if all of these hold:', \
        '', \
        tiTable(['Test', 'Companies left'], ['l', 'r'], [ \
            ['In the SEC financial data file', tiNumber(objectGet(funnel, 'inFile'), 0)], \
            ['Ever reported ' + tiBillions(objectGet(thresholds, 'prefilter_revenue')) + ' of annual revenue, and reports stock pay', \
                tiNumber(objectGet(funnel, 'prefilter'), 0)], \
            ['Still filing: the latest fiscal year ended within ' + objectGet(thresholds, 'still_filing_days') + ' days of the data date', \
                tiNumber(objectGet(funnel, 'current'), 0)], \
            ['Latest annual revenue of ' + tiBillions(objectGet(thresholds, 'revenue_min')) + ' or more', tiNumber(objectGet(funnel, 'revenue'), 0)], \
            [objectGet(thresholds, 'years_min') + ' or more years of data', tiNumber(objectGet(funnel, 'years'), 0)], \
            ['Revenue up ' + tiPercent(objectGet(thresholds, 'growth_min')) + ' or more over those years', tiNumber(objectGet(funnel, 'growth'), 0)], \
            ['Not in an excluded industry', tiNumber(objectGet(funnel, 'industry'), 0)], \
            ['Cumulative owner-cash margin under ' + line, tiNumber(objectGet(funnel, 'lowMargin'), 0)], \
            ['Stock pay is the cause', tiNumber(objectGet(funnel, 'stockPay'), 0)], \
            ['...and both pillars of the screen score can be built (ranked)', tiNumber(objectGet(funnel, 'ranked'), 0)] \
        ]), \
        '', \
        '**Excluded industries**, by SIC code: ' + arrayJoin(exclusions, '; ') + '. Their cash flows include customer money,', \
        'loans or property, so free cash flow does not mean the same thing.', \
        '', \
        '**Stock pay is the cause** when cumulative free cash flow is zero or positive, stock pay is at least ' + \
            tiPercent(objectGet(thresholds, 'sbc_revenue_min')) + ' of revenue, and stock pay is at least ' + \
            tiPercent(objectGet(thresholds, 'sbc_fcf_min')) + ' of free cash flow. Without this rule the screen is', \
        'dominated by distributors, retailers and companies that burn cash before any stock pay. Those are listed', \
        'separately, unranked, as "thin margin" and "cash burner".', \
        '', \
        '**Capital-led** companies are flagged, not removed: their capital spending is more than ' + \
            objectGet(thresholds, 'capital_led_ratio') + ' times their stock pay, so their shortfall is mostly investment.', \
        '', \
        '## The screen score (50 points)', \
        '', \
        'Points are linear between the two values given, and capped.', \
        '', \
        '**P1. No meaningful cash for owners (25 points)**', \
        '', \
        '- Share of years with an owner-cash margin under ' + line + ': 0 to ' + objectGet(thresholds, 'p1_years_points') + ' points.', \
        '- Cumulative owner-cash margin: 0 points at ' + tiPercent(objectGet(thresholds, 'p1_cum_zero')) + ', ' + \
            objectGet(thresholds, 'p1_cum_points') + ' at ' + tiPercent(objectGet(thresholds, 'p1_cum_full')) + '.', \
        '- Latest-12-month owner-cash margin: 0 points at ' + tiPercent(objectGet(thresholds, 'p1_latest_zero')) + ', ' + \
            objectGet(thresholds, 'p1_latest_points') + ' at ' + tiPercent(objectGet(thresholds, 'p1_latest_full')) + '.', \
        '  The latest 12 months are the latest fiscal year, plus the year-to-date period reported since, less the same', \
        '  period a year earlier. If the quarterly figures are unusable, the latest fiscal year is used and the row is noted.', \
        '', \
        'Where inventory, lending or a discontinued business moved operating cash flow by more than ' + \
            tiPercent(objectGet(thresholds, 'one_off_ocf_share')) + ' of revenue in a year, the company page shows P1 with and', \
        'without those years. The ranking uses all years.', \
        '', \
        '**P2b. Revenue that needs matching costs (' + objectGet(thresholds, 'p2b_points') + ' points, scaled to 25)**', \
        '', \
        '- Operating expenses excluding cost of revenue, as a percent of revenue, compared between the first and last of the', \
        '  latest ' + objectGet(thresholds, 'p2b_window_years') + ' fiscal years: ' + objectGet(thresholds, 'p2b_points') + \
            ' points if flat or up, 0 if down ' + objectGet(thresholds, 'p2b_zero_drop') + ' points.', \
        '- The cost line is built the same way in both years, by the first of these that works: ' + \
            objectGet(costMethods, '1') + '; ' + objectGet(costMethods, '2') + '; ' + objectGet(costMethods, '3') + '.', \
        '- If it cannot be built, the company has P1 alone and is unranked. Missing is not treated as zero.', \
        '', \
        '**Screen score = P1 + (P1 / 25) x (P2b scaled to 25)**', \
        '', \
        'P2b counts only to the extent owners are getting no cash. Flat costs are common at cash-rich companies too, so on', \
        'their own they say nothing.', \
        '', \
        '**Three-signs score (75 points) = P1 + (P1 / 25) x (costs + P3)**', \
        '', \
        "The index page's default order, because the three signs together are what the index is looking for: no cash for", \
        'owners (P1), revenue held up by costs, and insiders who are granted shares and sell them (P3, described below). Of the ' + \
            objectGet(funnel, 'ranked') + ' ranked companies, ' + objectGet(funnel, 'rankedThree') + ' have all three.', \
        '', \
        'The **costs sign (25 points)** has two halves. One is P2b, scaled to 12.5: whether operating costs fell against revenue.', \
        'The other is their level: operating costs excluding cost of revenue as a share of gross profit in the latest fiscal', \
        'year, 0 points at ' + tiPercent(objectGet(thresholds, 'cost_level_zero')) + ' and 12.5 at ' + \
            tiPercent(objectGet(thresholds, 'cost_level_full')) + ' or more. P2b alone gives nothing to a company whose', \
        'spending is very high but falling; the level does. Among the companies that produce meaningful owner cash, operating', \
        'costs typically take about two thirds of gross profit.', \
        '', \
        'The three-signs score is provisional. The costs level and P3 are new measures whose scales are untested judgment, and', \
        "they are not part of the agreed definition's screen score. Each company page also reports sales and marketing,", \
        'research and development, and general and administrative spending as a share of revenue where the company tags them;', \
        'these are not scored.', \
        '', \
        '## Why these choices', \
        '', \
        '- The cost test uses the latest five years because a full-history test rewards any company that listed young.', \
        '- Points scale with size because hard cut-offs made ranks flip on small changes. The ' + \
            argsLink(tiArguments, 'data and limits', {'page': 'data'}, true, argsTopHeaderId) + ' page shows which top-ten ranks still move', \
        '  when a threshold moves by a fifth, and the ' + argsLink(tiArguments, 'threshold explorer', {'page': 'explore'}, true, argsTopHeaderId) + \
            ' lets you move them.', \
        '', \
        '## Not in this release', \
        '', \
        'The full index (100 points) for the top 25 adds three pillars. No full score is published, and their point scales are', \
        'untested judgment:', \
        '', \
        '- **P2a.** Real gross profit per employee, annual growth. Needs headcount from annual reports. Not measured.', \
        '- **P3.** Insiders granting and selling, over the latest ' + objectGet(thresholds, 'p3_years') + ' calendar years: the share of', \
        '  years with both new grants and open-market sales (0 to ' + objectGet(thresholds, 'p3_years_points') + ' points), and', \
        '  open-market sales as a multiple of grants (0 points at ' + objectGet(thresholds, 'p3_ratio_zero') + ' times, ' + \
            objectGet(thresholds, 'p3_ratio_points') + ' at ' + objectGet(thresholds, 'p3_ratio_full') + ' times).', \
        '  **Measured, and shown on each company page as provisional.** The definition calls for the grant-date fair value of', \
        '  grants, which the SEC data does not give consistently. Grants are valued instead at the market price of the shares', \
        '  they cover, which overstates options and so understates the multiple.', \
        '- **P4.** Headline numbers that leave out stock pay: stock pay as a share of adjusted profit in earnings releases.', \
        '  Not measured.', \
        '', \
        'Also not done: confirming each company was founded ten or more years ago, combining predecessor companies,', \
        'adjusting share counts for splits, valuation, and governance facts.', \
        '', \
        '## Glossary', \
        '', \
        tiGlossaryLines(), \
        '', \
        '## Rules', \
        '', \
        '- Every published figure traces to an SEC filing, linked from the company page.', \
        '- The index includes what cuts the other way: recent improvement, one-off causes and cash returned.', \
        "- No statement here says a company's reporting is false or misleading. Only a court or regulator can find that." \
    )
endfunction


# The glossary - each term and its meaning
tiGlossary = [ \
    ['Owner cash', 'Free cash flow less stock pay: the cash a year of business leaves for the people who own the shares.'], \
    ['Free cash flow', 'Cash from operations less capital spending. It does not subtract stock pay, because stock pay uses no cash.'], \
    ['Stock pay', "Stock-based compensation: wages paid in shares and options. It costs owners a share of the company, not the company's cash."], \
    ['Meaningful owner cash', 'Owner cash of at least the stated share of revenue.'], \
    ['Capital-led', 'A company whose capital spending is more than twice its stock pay. Its shortfall is mostly investment.'], \
    ['Insider', 'An officer or director who must report trades in the company to the SEC.'], \
    ['Grant', 'Shares, share units or options awarded to an insider as pay.'], \
    ['Open-market sale', 'A sale on the exchange. It leaves out shares withheld for taxes, gifts, and shares sold back to the company.'], \
    ['Buyback', 'A company buying its own shares. It returns cash to owners only if it leaves fewer shares.'], \
    ['Treadmill', 'The pattern the index looks for: no cash for owners, revenue held up by costs, and insiders who are granted shares and sell them, year after year.'], \
    ['Latest 12 months', 'The latest fiscal year, plus the part-year reported since, less the same part of the year before.'] \
]


# Get the glossary's lines
function tiGlossaryLines():
    lines = []
    for term in tiGlossary:
        arrayPush(lines, '- **' + arrayGet(term, 0) + '.** ' + arrayGet(term, 1))
    endfor
    return lines
endfunction


#
# The data and limits page
#


function tiDataPage(meta):
    sources = objectGet(meta, 'sources')
    companyfacts = objectGet(sources, 'companyfacts')
    types = objectGet(meta, 'types')
    excluded = objectGet(meta, 'excluded')
    cost = objectGet(meta, 'cost')
    thresholds = objectGet(meta, 'thresholds')

    # The type rows
    typeRows = []
    for type in tiTypes:
        arrayPush(typeRows, [objectGet(type, 'title'), '' + objectGet(types, objectGet(type, 'name'), 0), objectGet(type, 'text')])
    endfor
    excludedRows = []
    for group in arraySort(objectKeys(excluded)):
        arrayPush(excludedRows, group + ' ' + objectGet(excluded, group))
    endfor

    # The sensitivity rows
    sensitivityRows = []
    unchanged = []
    for entry in objectGet(meta, 'sensitivity'):
        changes = []
        for change in objectGet(entry, tiChangesKey(meta)):
            from = objectGet(change, 'from')
            to = objectGet(change, 'to')
            arrayPush(changes, markdownEscape(objectGet(change, 'name')) + ' ' + \
                if(from == null, 'enters at ' + to, if(to == null, 'leaves (was ' + from + ')', from + ' to ' + to)))
        endfor
        key = objectGet(entry, 'threshold')
        label = objectGet(tiThresholdNames, key, key) + ', ' + if(objectGet(entry, 'factor') < 1, 'a fifth lower', 'a fifth higher')
        if arrayLength(changes):
            arrayPush(sensitivityRows, [label, '`' + key + '` = ' + objectGet(entry, 'value'), arrayJoin(changes, '; ')])
        else:
            arrayPush(unchanged, label)
        endif
    endfor

    documentSetTitle('Data and limits - ' + tiTitle)
    markdownPrint( \
        '', \
        '# Data and limits', \
        '', \
        '## Sources', \
        '', \
        '- Financial figures: the SEC bulk file [companyfacts.zip](' + objectGet(companyfacts, 'url') + '). The latest filing in', \
        '  it is dated **' + objectGet(meta, 'dataDate') + '**; that is the as-of date of everything here.', \
        '  File size ' + tiNumber(objectGet(companyfacts, 'bytes'), 0) + ' bytes, SHA-256 `' + objectGet(companyfacts, 'sha256') + '`.', \
        '- Industry codes, tickers and former names: the [SEC company API](' + objectGet(objectGet(sources, 'submissions'), 'url') + ').', \
        tiDataInsiderSource(sources), \
        '- Method version ' + objectGet(meta, 'methodVersion') + '. A figure cited from this page can be reproduced from the same', \
        '  SEC file and the same method version.', \
        '', \
        '## What is in the data', \
        '', \
        tiTable(['Type', 'Companies', 'Meaning'], ['l', 'r', 'l'], typeRows), \
        '', \
        'Excluded industries: ' + arrayJoin(excludedRows, ', ') + '.', \
        '', \
        '## Known limits', \
        '', \
        "- **History starts about 2009.** The SEC has collected financial statements as data only since then. A company's", \
        '  "whole period" is the years it has in that data, which can be shorter than its life.', \
        '- **Fiscal years.** A fiscal year ending in January, February or March is labelled with the prior calendar year.', \
        '- **Revenue** is the largest of four revenue tags for the year. Pass-through revenue (for example, the face value', \
        '  of cryptocurrency sold) makes revenue-based ratios look smaller.', \
        '- **Capital spending** is purchases of property and equipment (or of productive assets) plus capitalized software.', \
        '  A year with neither tag counts as zero and is noted.', \
        '- **The cost line** cannot be built for ' + objectGet(cost, 'missingAll') + ' companies (' + objectGet(cost, 'missing') + \
            ' of those that pass the screen) because of inconsistent tagging. They are unranked.', \
        '- **Latest 12 months** fall back to the latest fiscal year when a quarterly figure is missing or tagged differently.', \
        "- **Industry codes** are the SEC's and are coarse. Securities brokers are excluded along with asset managers, because", \
        '  they hold customer money. Insurance agents and brokers are not excluded: they are not insurers. Some real-estate and', \
        '  payment companies are not excluded.', \
        '- **Restated years.** Each year uses its most recently filed value. When a company restates recent years for a', \
        '  business it has left, older years are not restated, so the two can sit side by side.', \
        '- **Foreign companies** that file financial data with the SEC in US dollars are included.', \
        '- **Predecessor companies** are not combined, and **share counts** are not adjusted for splits.', \
        '- **Founding dates** are not in the data. Some listed companies are less than ten years old.', \
        '- **Capital-led companies** pass the screen but their shortfall is mostly capital spending. They are flagged.', \
        '- **Insiders** are officers and directors who file as people. A filing made with an entity counts only if one of', \
        "  its people is an officer, and an outside director's shares held through an entity are left out unless the filing", \
        '  says the holder is a trust, family or a retirement account. Some fund sales may still be counted, and some personal', \
        '  holdings left out.', \
        '- **Insider grants** are valued at the market price of the shares they cover, not at their accounting fair value.', \
        '  Options and performance awards are overstated. Amended insider filings are not used. A price far from the', \
        "  company's other reported prices is treated as a filing error and left out.", \
        '', \
        '## If a threshold moves by a fifth', \
        '', \
        'Each threshold was moved down and up by a fifth, one at a time, and the index rebuilt. These are the changes in the', \
        'top ten by ' + if(tiChangesKey(meta) == 'changesThree', 'three-signs score', 'screen score') + '.', \
        '', \
        tiTable(['Threshold moved', 'Value', 'Changes in the top ten'], ['l', 'l', 'l'], sensitivityRows), \
        '', \
        'No change in the top ten: ' + if(arrayLength(unchanged), arrayJoin(unchanged, '; '), 'none') + '.', \
        '', \
        "The thresholds, at the definition's values: " + tiThresholdList(thresholds) + '.', \
        '', \
        '## Change log', \
        '', \
        tiChangeLines(), \
        '', \
        '## Corrections', \
        '', \
        'If a figure here does not match the linked SEC filing, it is an error in this index. Report it at the', \
        '[project repository](https://github.com/craigahobbs/treadmill-index/issues) with the company and the year.' \
    )
endfunction


# The method's change log, newest first
tiChanges = [ \
    ['1.0.0', 'First release. Stage 1 screen and screen score (P1 and P2b) from SEC financial data. Insider grants and sales ' + \
        'from SEC Forms 4 and 5, with a provisional P3. A provisional three-signs score: P1, a costs sign, and P3.'] \
]


# Get the change log's lines
function tiChangeLines():
    lines = []
    for change in tiChanges:
        arrayPush(lines, '- **Method version ' + arrayGet(change, 0) + '.** ' + arrayGet(change, 1))
    endfor
    return lines
endfunction


# The plain names of the thresholds in the sensitivity test
tiThresholdNames = { \
    'revenue_min': 'Least latest revenue', \
    'years_min': 'Least years of data', \
    'growth_min': 'Least revenue growth', \
    'meaningful_margin': 'Meaningful owner cash', \
    'sbc_revenue_min': 'Least stock pay, share of revenue', \
    'sbc_fcf_min': 'Least stock pay, share of free cash flow', \
    'p1_cum_zero': 'P1 cumulative margin that scores 0', \
    'p1_cum_full': 'P1 cumulative margin that scores 8', \
    'p1_latest_zero': 'P1 latest margin that scores 0', \
    'p1_latest_full': 'P1 latest margin that scores 7', \
    'p2b_window_years': 'P2b window, in years', \
    'p2b_zero_drop': 'P2b cost fall that scores 0', \
    'cost_level_zero': 'Costs as a share of gross profit that score 0', \
    'cost_level_full': 'Costs as a share of gross profit that score in full', \
    'p3_ratio_zero': 'P3 sales as a multiple of grants that score 0', \
    'p3_ratio_full': 'P3 sales as a multiple of grants that score 13' \
}


# Get the data and limits page's insider source line
function tiDataInsiderSource(sources):
    insider = objectGet(sources, 'insider')
    files = if(insider != null, objectGet(insider, 'files'), [])
    if !arrayLength(files):
        return '- Insider transactions: not in this build.'
    endif
    return '- Insider transactions: the SEC [insider transactions data sets](' + objectGet(insider, 'url') + '), ' + \
        arrayLength(files) + ' quarterly files from `' + arrayGet(files, 0) + '` to `' + arrayGet(files, arrayLength(files) - 1) + '`.'
endfunction


# Format the thresholds as a list of "name = value"
function tiThresholdList(thresholds):
    items = []
    for key in arraySort(objectKeys(thresholds)):
        arrayPush(items, '`' + key + '` = ' + objectGet(thresholds, key))
    endfor
    return arrayJoin(items, ', ')
endfunction


#
# The downloads page
#


function tiDownloadsPage(builds):
    buildLines = []
    for build in if(builds != null, builds, []):
        dataDate = objectGet(build, 'dataDate')
        buildDir = 'data/archive/' + dataDate + '/'
        arrayPush(buildLines, '- Data as of **' + dataDate + '**, method version ' + objectGet(build, 'methodVersion') + ', ' + \
            objectGet(build, 'ranked') + ' ranked: [index.csv](' + buildDir + 'index.csv), [index.json](' + buildDir + \
            'index.json), [meta.json](' + buildDir + 'meta.json)')
    endfor

    documentSetTitle('Downloads - ' + tiTitle)
    markdownPrint( \
        '', \
        '# Downloads', \
        '', \
        '- [index.csv](data/index.csv): one row per company that passes the basic tests, with every input, score, type and flag.', \
        "- [index.json](data/index.json): the same rows, plus each company's yearly owner-cash margins.", \
        '- [meta.json](data/meta.json): the as-of date, source file hash, screen counts, every threshold, group totals and the', \
        '  sensitivity test.', \
        '- `data/company/<CIK>.json`: one file per company, with its yearly series. Every figure carries the accession number,', \
        '  form and filing date of the SEC filing it came from.', \
        '', \
        'Money is in US dollars. Margins and ratios are fractions (0.03 is 3%). An empty CSV cell, or a JSON null, means the', \
        'figure is not in the filings.', \
        '', \
        '## Every build', \
        '', \
        'Each build is kept, so a figure cited from an earlier one can be found again. Company files are kept only for the', \
        'latest build.', \
        '', \
        if(arrayLength(buildLines), buildLines, 'No builds are listed.') \
    )
endfunction

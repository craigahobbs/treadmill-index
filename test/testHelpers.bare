include <dataLineChart.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../treadmillIndex.bare'


# Load test data files for the systemFetch mock. With a directory, the files are loaded from that directory of
# the test data - "noinsider/" is the build without the insider data sets.
async function testData(urls, dir):
    paths = []
    for url in urls:
        arrayPush(paths, stringReplace(url, 'data/', 'data/' + if(dir != null, dir, '')))
    endfor
    texts = systemFetch(paths)
    data = {}
    for url, ixURL in urls:
        objectSet(data, url, arrayGet(texts, ixURL))
    endfor
    return {'systemFetch': data}
endfunction


# Get the expected chart render call for a test company file
function testChartCall(data, url):
    company = jsonParse(objectGet(objectGet(data, 'systemFetch'), url))
    chart = tiYearsChart(objectGet(company, 'years'), 0.03)
    return ['elementModelRender', [{'html': 'p', 'elem': dataLineChartElements(objectGet(chart, 'data'), objectGet(chart, 'model'))}]]
endfunction


# Find a control's event callback in a rendered element model - by the control's ID, or by its text
function testFindCallback(model, idOrText, event):
    type = systemType(model)
    if type == 'array':
        for item in model:
            found = testFindCallback(item, idOrText, event)
            if found != null:
                return found
            endif
        endfor
    elif type == 'object':
        elem = objectGet(model, 'elem')
        callback = objectGet(model, 'callback')
        isMatch = objectGet(objectGet(model, 'attr', {}), 'id') == idOrText || \
            (systemType(elem) == 'object' && objectGet(elem, 'text') == idOrText)
        if callback != null && isMatch:
            return objectGet(callback, event)
        endif
        return testFindCallback(elem, idOrText, event)
    endif
    return null
endfunction


# Verify that two functions have the same effect
async function testSameEffect(actualFn, expectedFn, data):
    unittestMockAll(data)
    expectedFn()
    expected = unittestMockEnd()
    unittestMockAll(data)
    actualFn()
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction

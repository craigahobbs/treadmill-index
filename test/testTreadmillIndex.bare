function testNumber():
    unittestEqual(tiNumber(0, 0), '0')
    unittestEqual(tiNumber(999, 0), '999')
    unittestEqual(tiNumber(1000, 0), '1,000')
    unittestEqual(tiNumber(1234567.4, 0), '1,234,567')
    unittestEqual(tiNumber(-20609, 0), '-20,609')
    unittestEqual(tiNumber(6533.84, 1), '6,533.8')
    unittestEqual(tiNumber(-0.25, 2), '-0.25')
endfunction
unittestRunTest('testNumber')


function testMoney():
    unittestEqual(tiMoney(null), 'n/a')

function testRowNotes():
    unittestEqual(tiRowNotes({'flags': [], 'capitalLed': false}), '')
    unittestEqual(tiRowNotes({'flags': [], 'capitalLed': true}), 'C')
    unittestEqual(tiRowNotes({'flags': ['share_count_jump', 'one_off_years'], 'capitalLed': false}), 'O S')
    unittestEqual( \
        tiRowNotes({ \
            'flags': ['capex_missing', 'no_cost_line', 'latest_is_fiscal_year', 'one_off_years', 'gap_years', 'revenue_jump', 'share_count_jump'], \
            'capitalLed': true \
        }), \

function testTable():
    unittestDeepEqual( \
        tiTable(['Name', 'Value'], ['l', 'r'], [['A', '1'], ['B', '2']]), \
        ['| Name | Value |', '| :-- | --: |', '| A | 1 |', '| B | 2 |'] \
    )
    unittestDeepEqual(tiTable(['Name'], ['l'], []), ['| Name |', '| :-- |'])
endfunction
unittestRunTest('testTable')



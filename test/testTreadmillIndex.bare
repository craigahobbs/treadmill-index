function testRowNotes():
    unittestEqual(tiRowNotes({'flags': []}), '')
    unittestEqual(tiRowNotes({'flags': ['share_count_jump', 'one_off_years']}), 'O')
    unittestEqual( \
        tiRowNotes({'flags': [ \
            'capex_missing', 'no_insider_filings', 'no_cost_line', 'latest_is_fiscal_year', 'one_off_years', 'gap_years', \
            'revenue_jump', 'share_count_jump' \
        ]}), \
        'O N I' \
    )
endfunction
unittestRunTest('testRowNotes')


function testCompareRows():
    rowA = {'name': 'A', 'p1': 10}
    rowB = {'name': 'B', 'p1': 20}
    unittestEqual(tiCompareRows('name', false, rowA, rowB), -1)
    unittestEqual(tiCompareRows('name', false, rowB, rowA), 1)
    unittestEqual(tiCompareRows('p1', true, rowA, rowB), 1)
    unittestEqual(tiCompareRows('p1', true, rowB, rowA), -1)
    unittestEqual(tiCompareRows('p1', true, rowA, rowA), 0)
endfunction
unittestRunTest('testCompareRows')


function testThresholdList():
    unittestEqual(tiThresholdList({'years_min': 5, 'growth_min': 0.5}), '`growth_min` = 0.5, `years_min` = 5')
endfunction
unittestRunTest('testThresholdList')


# The find handler sets the "find" argument, resets "all" and keeps the other arguments
function testOnFind():
    systemGlobalSet('vType', 'all')
    systemGlobalSet('vAll', true)
    unittestMockAll({'documentInputValue': {'tiFind': '  Zillow '}})
    tiOnFind()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['documentInputValue', ['tiFind']], \
        ['windowSetLocation', ["#var.vFind='Zillow'&var.vType='all'"]] \
    ])

    # Empty find text clears the "find" argument
    systemGlobalSet('vFind', 'Zillow')
    unittestMockAll({'documentInputValue': {'tiFind': ' '}})
    tiOnFind()
    unittestDeepEqual(unittestMockEnd(), [ \
        ['documentInputValue', ['tiFind']], \
        ['windowSetLocation', ["#var.vType='all'"]] \
    ])
    systemGlobalSet('vType', null)
    systemGlobalSet('vAll', null)
    systemGlobalSet('vFind', null)
endfunction
unittestRunTest('testOnFind')


# The find text input's enter key and the find button are bound to the find handler
async function testOnFindBinding():
    data = testData(['data/meta.json', 'data/index.json'])
    objectSet(data, 'documentInputValue', {'tiFind': 'cash'})
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()

    # The enter key (13) finds; other keys do not
    keyup = testFindCallback(log, 'tiFind', 'keyup')
    testSameEffect(systemPartial(keyup, 13), tiOnFind, data)
    unittestMockAll(data)
    keyup(65)
    unittestDeepEqual(unittestMockEnd(), [])

    # The find button
    click = testFindCallback(log, 'Find', 'click')
    testSameEffect(click, tiOnFind, data)

    # Unknown controls
    unittestEqual(testFindCallback(log, 'Unknown', 'click'), null)
endfunction
unittestRunTest('testOnFindBinding')

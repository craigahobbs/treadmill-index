endfunction
unittestRunTest('testYears')


function testYearsChart():
    model = { \
        'title': 'Owner cash as a percent of revenue', \
        'width': 720, \
        'height': 300, \
        'x': 'Fiscal year', \
        'y': ['Owner-cash margin (%)'], \
        'precision': 0, \
        'yLines': [{'value': 3, 'label': '3.0%'}] \
    }

    # Every year is within the chart limit
    unittestDeepEqual( \
        tiYearsChart([{'fy': '2024', 'margin': -1}, {'fy': '2025', 'margin': 0.25}], 0.03), \
        { \
            'data': [ \
                {'Fiscal year': 2024, 'Owner-cash margin (%)': -100}, \
                {'Fiscal year': 2025, 'Owner-cash margin (%)': 25} \
            ], \
            'model': model, \
            'clipped': [] \
        } \
    )

    # Years beyond the chart limit are drawn at the limit and listed with their values
    unittestDeepEqual( \
        tiYearsChart([{'fy': '2021', 'margin': -1.671}, {'fy': '2022', 'margin': 2.011}, {'fy': '2023', 'margin': -0.125}], 0.03), \
        { \
            'data': [ \
                {'Fiscal year': 2021, 'Owner-cash margin (%)': -100}, \
                {'Fiscal year': 2022, 'Owner-cash margin (%)': 100}, \
                {'Fiscal year': 2023, 'Owner-cash margin (%)': -12.5} \
            ], \
            'model': objectAssign(objectCopy(model), {'yMin': -100, 'yMax': 100}), \
            'clipped': ['2021 (-167%)', '2022 (201%)'] \
        } \
    )
endfunction
unittestRunTest('testYearsChart')



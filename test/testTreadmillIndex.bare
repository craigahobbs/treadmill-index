include <args.bare>
include <forms.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../treadmillIndex.bare'
include 'testHelpers.bare'


function testNumber():
    unittestEqual(tiNumber(0, 0), '0')
    unittestEqual(tiNumber(999, 0), '999')
    unittestEqual(tiNumber(1000, 0), '1,000')
    unittestEqual(tiNumber(1234567.4, 0), '1,234,567')
    unittestEqual(tiNumber(-20609, 0), '-20,609')
    unittestEqual(tiNumber(6533.84, 1), '6,533.8')
    unittestEqual(tiNumber(-0.25, 2), '-0.25')
endfunction
unittestRunTest('testNumber')


function testMoney():
    unittestEqual(tiMoney(null), 'n/a')
    unittestEqual(tiMoney(2583000000), '$2,583M')
    unittestEqual(tiMoney(-1375355000), '-$1,375M')
    unittestEqual(tiMoney(0), '$0M')
endfunction
unittestRunTest('testMoney')


function testDollars():
    unittestEqual(tiDollars(0), '$0')
    unittestEqual(tiDollars(5500), '$6K')
    unittestEqual(tiDollars(999999), '$1,000K')
    unittestEqual(tiDollars(1000000), '$1.0M')
    unittestEqual(tiDollars(346022932), '$346.0M')
    unittestEqual(tiDollars(32825940004), '$32.8B')
    unittestEqual(tiDollars(6533800000000), '$6,533.8B')
    unittestEqual(tiDollars(-5792453647), '-$5.8B')
    unittestEqual(tiDollars(-175000000), '-$175.0M')
    unittestEqual(tiDollars(-5500), '-$6K')
endfunction
unittestRunTest('testDollars')


function testInsiderAmounts():
    item = { \
        'cashOut': -4883760, 'sales': 110200, 'grants': 110000, 'optionGrants': 300000, 'withheld': 5500, 'toIssuer': 540, \
        'purchases': 4000000, 'exercised': 1000000 \
    }
    unittestDeepEqual(tiInsiderAmounts(['2024'], item), ['2024', '-$4.9M', '$110K', '$6K', '$5.0M', '$110K', '$300K'])
    unittestEqual(arrayLength(tiInsiderHeaders), 6)
endfunction
unittestRunTest('testInsiderAmounts')


function testSignMark():
    unittestEqual(tiSignMark(true, 'Took 101.8% of gross profit'), '✅ Took 101.8% of gross profit')
    unittestEqual(tiSignMark(false, 'Took 61.6% of gross profit'), '❌ Took 61.6% of gross profit')
    unittestEqual(tiSignMark(null, 'n/a: the cost line cannot be built'), 'n/a: the cost line cannot be built')
endfunction
unittestRunTest('testSignMark')


function testCashOut():
    unittestEqual(tiCashOut(346022932), 'took $346.0M out through stock')
    unittestEqual(tiCashOut(0), 'took $0 out through stock')
    unittestEqual(tiCashOut(-30000), 'bought $30K more than they took out through stock')
endfunction
unittestRunTest('testCashOut')


function testShares():

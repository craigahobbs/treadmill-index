# No industry code
async function testMain_companyNoIndustry():
    data = testData(['data/meta.json', 'data/company/8.json'])
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 8)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)
    systemGlobalSet('vCik', null)
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/company/8.json'] \
            ] \
        ], \

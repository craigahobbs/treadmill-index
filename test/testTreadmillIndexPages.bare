include <dataLineChart.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../treadmillIndex.bare'
include 'testHelpers.bare'


# The page render tests. Each compares the whole render log of a page against the expected log.
#
# This file is generated: "make test-pages" renders the page states in test/makeTestPages.py against the test data,
# test/data/, which "make test-data" makes from the made-up companies in test/makeTestData.py.


# The index page: the companies that pass the screen, in score order
async function testMain_index():
    data = testData(['data/meta.json', 'data/index.json'])
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/index.json'] \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                'Index | [Group Totals](#var.vPage=\'totals\'&_top) | [Methodology](#var.vPage=\'method\'&_top) | [Data and Limits](#var.vPage=\'data\'&_top)' \
            ] \
        ], \
        [ \
            'documentSetTitle', \
            ['The Treadmill Index'] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '# The Treadmill Index', \
                '', \
                'Large, growing companies whose revenue growth has not become meaningful cash for outside owners, because the cash', \
                'goes out as stock pay. Owner cash is free cash flow less stock-based compensation; "meaningful" is 3.0% of revenue.', \
                'Of 11 companies in the SEC data, 5 pass the screen and 4 are ranked. [How it is computed](#var.vPage=\'method\'&_top).', \
                '', \
                '## What a High Rank Can Mean for a Shareholder', \
                '', \
                '**The headline.** A company with no owner cash cannot be valued on what it earns for its owners. It is valued on revenue', \
                'growth, and on profit measures that leave stock pay out. Where that revenue is held up by spending that has to go on,', \
                'such as a large sales force, a valuation on owner cash would be far lower. At the higher valuation its insiders are', \
                'granted shares, and can sell them, every year. The view of this index is that at some companies this is the point: owner', \
                'cash is kept near zero so that the company is never valued on it, while insiders turn grants into cash at the price that', \
                'results. Shareholders who take "investing in growth" on trust bear the cost. The numbers cannot say at which companies', \
                'this is deliberate: a real bet on growth looks the same until it pays off.', \
                '', \
                '**The three signs.** The index looks for three things together, each one visible in the filings. A real growth bet', \
                'loses them in time: owner cash appears as growth slows, costs leave part of gross profit, and insiders take out little.', \
                '', \
                '1. **Owner cash that stays near zero.** Together the 5 companies here recorded $6.8B of stock pay against $5.2B of free cash flow.', \
                '   At 5 of the 5, owner cash has been under 3.0% of revenue for five or more fiscal years running.', \
                '2. **Revenue held up by costs.** Operating costs are mostly people, and have to go on for the revenue to go on. At 1 of the 5,', \
                '   they took all of gross profit or more in the latest year. Cash that does arrive can go to buying back the shares just', \
                '   granted: of the 1 that bought back shares over five years and whose share count can be followed,', \
                '   the count still rose at 1, after $40.0M spent on buybacks and employees\' vesting taxes.', \
                [ \
                    '3. **Insiders who cash out.** In 2021‑2025, the officers and directors of 4 of these companies took $420.0M out through stock:', \
                    '   open-market sales and shares given up for taxes, less what they paid to buy shares and exercise options. That is 1.3% of those companies\' revenue over the same years.', \
                    '   Their owners got -2.1%. At the companies that do produce cash for owners, insiders took out 18.6% of revenue and owners got 8.0%.' \
                ], \
                '', \
                '**What it costs a shareholder.** Each share owns a smaller part of a company that produces no cash for its owners, at a', \
                'price that cannot be checked against what it earns. A falling share price makes it worse: the same pay takes more shares.', \
                '', \
                '**What a rank does not prove.** A rank measures a pattern. It is not a finding about any one company\'s purpose, and not', \
                'a forecast that its shares will fall. 0 of the 5 had meaningful owner cash in their latest 12 months. Each company page shows which way', \
                'its own numbers point, and what cuts the other way. [Group Totals](#var.vPage=\'totals\'&_top) has every figure, with the companies that', \
                'do produce cash for their owners beside them as a baseline.', \
                '', \
                '## The Index' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '**Show:** Stock pay (5) | [Capital\\-led \\(1\\)](#var.vType=\'capital_led\') | [Thin margin \\(1\\)](#var.vType=\'thin_margin\') | [Cash burner \\(1\\)](#var.vType=\'cash_burner\') | [Cash generative \\(1\\)](#var.vType=\'cash_generative\') | [Excluded industry \\(1\\)](#var.vType=\'excluded\') | [All \\(10\\)](#var.vType=\'all\') \\\n**Sort:** Score | [Owner cash](#var.vSort=\'owner\') | [Costs](#var.vSort=\'costs\') | [Insider cash\\-out](#var.vSort=\'insiders\') | [Name](#var.vSort=\'name\')', \
                '', \
                '*Stock pay:* Passed the screen: owner cash is under the line and stock pay is the cause.' \
            ] \
        ], \
        [ \
            'elementModelRender', \
            [ \
                { \
                    'elem': [ \
                        {'elem': {'text': 'Find a company or ticker: '}, 'html': 'b'}, \
                        { \
                            'attr': { \
                                'autocomplete': 'off', \
                                'id': 'tiFind', \
                                'size': 30, \
                                'style': 'font-size: inherit; border: thin solid black; padding: 0.4em;', \
                                'type': 'text', \
                                'value': '' \
                            }, \
                            'callback': {'keyup': '<function>'}, \
                            'html': 'input' \
                        }, \
                        {'text': ' '}, \
                        { \
                            'attr': {'style': 'cursor: pointer; user-select: none;'}, \
                            'callback': {'click': '<function>'}, \
                            'elem': {'text': 'Find'}, \
                            'html': 'a' \
                        }, \
                        [] \
                    ], \
                    'html': 'p' \
                } \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                [ \
                    '| Rank | Company | Ticker | Score (75) | Owner cash (25) | Costs (25) | Insiders (25) | Owner-cash margin | Costs / gross profit | Insider cash-out / revenue | Notes |', \
                    '| --: | :-- | :-- | --: | --: | --: | --: | --: | --: | --: | :-- |', \
                    '| 1 | [No Gross Profit Co](#var.vCik=11&var.vPage=\'company\'&_top) | NGP | 67.0 | 22.3 | 25.0 | 25.0 | -5.0% | no gross profit | 4.0% |  |', \
                    '| 2 | [Stock Pay Co](#var.vCik=1&var.vPage=\'company\'&_top) | SPAY | 37.6 | 18.6 | 18.1 | 7.4 | -2.0% | 91.7% | 1.2% |  |', \
                    '| 3 | [One\\-Off Co](#var.vCik=6&var.vPage=\'company\'&_top) | OOC | 36.3 | 21.1 | 18.1 | 0.0 | -4.0% | 91.7% | 0.0% | O |', \
                    '| 4 | [Marginal Co](#var.vCik=10&var.vPage=\'company\'&_top) | MARG | 22.3 | 13.0 | 18.1 | 0.0 | 2.6% | 91.7% | 0.0% |  |', \
                    '|  | [No Cost Line Co](#var.vCik=3&var.vPage=\'company\'&_top) | NCL | n/a | 24.0 | n/a | n/a | -8.2% | n/a | n/a | N I |' \
                ] \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '**Rank** is by score, among the companies that pass the screen and have all three signs. Unranked companies are listed', \
                'for comparison only.', \
                '', \
                '**The score is out of 75**, 25 for each sign: owner cash + (owner cash / 25) x (costs + insiders). Costs and insider', \
                'cash-out count only to the extent owners are getting no cash.', \
                '', \
                '**Owner-cash margin** covers every fiscal year in the SEC data. **Costs / gross profit** is operating costs in the latest', \
                'fiscal year. **Insider cash-out / revenue** is what officers and directors took out through stock in 2021‑2025,', \
                'against the company\'s revenue in those years.', \
                '', \
                '**Neighbouring ranks are close.** Moving one threshold by a fifth changes the top ten in 2 of 30 tests.', \
                'Read a rank as a rough position, not a precise one. [Data and Limits](#var.vPage=\'data\'&_top) lists every change.', \
                '', \
                '**Notes**', \
                '' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **O** - Inventory, lending or a discontinued business moved operating cash flow by more than a quarter of revenue in at least one year. The company page shows the first sign with and without those years.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **N** - The cost line cannot be built from the filing tags, so the costs sign is missing and the company has no score.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **I** - No insider transactions in the SEC data sets for the five years, so the insiders sign is missing and the company has no score. Foreign companies have not had to file them.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '---', \
                '', \
                'Data as of 2026-11-05, from SEC filings. Method version 1.1.0.', \
                'History starts about 2009, when the SEC began collecting financial statements as data.', \
                '', \
                'The index ranks how outside owners have been treated. It is not a short list, a price forecast or investment advice,', \
                'and it makes no finding about any one company\'s intent.' \
            ] \
        ] \
    ])
endfunction
unittestRunTest('testMain_index')


# All types, sorted by owner-cash margin, with more rows than the row limit

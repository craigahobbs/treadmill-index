endfunction
unittestRunTest('testMain_companyNoIndustry')


# An unknown company
async function testMain_companyUnknown():
    data = testData(['data/meta.json'])
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 99)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)

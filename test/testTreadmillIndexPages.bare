unittestRunTest('testMain_companyNoCashOut')


# Unranked with a score, former names, a share count change, cash returned
async function testMain_companyCashGenerative():
    data = testData(['data/meta.json', 'data/company/4.json'])
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 4)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)
    systemGlobalSet('vCik', null)
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/company/4.json'] \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '[Index](#var=&_top) | [Group Totals](#var.vPage=\'totals\'&_top) | [Methodology](#var.vPage=\'method\'&_top) | [Data and Limits](#var.vPage=\'data\'&_top)' \
            ] \
        ], \
        [ \
            'documentSetTitle', \
            ['Cash Co - The Treadmill Index'] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '# Cash Co', \
                '', \
                '**Ticker:** CASH (NYSE) \\\n**SEC filings:** [CIK 4](https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&CIK=4&type=10-K) \\\n**Industry:** Services\\-Prepackaged Software ([SIC 7372](#var.vSic=7372&var.vType=\'all\'&_top)) \\\n**Formerly:** Old Cash Co; Older Cash Co \\\n**Type:** Cash generative. Owner cash is at or above the line. These companies are the baseline.', \
                '', \
                'From fiscal 2019 to 2025, Cash Co reported $10.2 billion of revenue and $1.0 billion of free cash flow. Stock pay was $203 million, which leaves $812 million of owner cash: 8.0% of revenue. Owner cash was under 3.0% of revenue in 0 of 7 years. In the 12 months to 2026-09-30 it was 8.0% of revenue.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '## Which Way the Numbers Point', \
                '', \

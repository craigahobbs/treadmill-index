# A company's page in a build without the insider data sets
async function testMain_companyNoInsider():
    data = testData(['data/meta.json', 'data/company/1.json'], 'noinsider/')
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 1)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)
    systemGlobalSet('vCik', null)
    unittestDeepEqual(log, [ \

unittestRunTest('testMain_companyPerson')


# One-off years, two capital spending tags, no latest 12 months, a share count jump
async function testMain_companyOneOff():
    data = testData(['data/meta.json', 'data/company/6.json'])
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 6)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)
    systemGlobalSet('vCik', null)
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/company/6.json'] \
            ] \
        ], \
        [ \

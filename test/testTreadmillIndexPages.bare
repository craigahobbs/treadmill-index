include <dataLineChart.bare>
include <unittest.bare>
include <unittestMock.bare>
include '../treadmillIndex.bare'
include 'testHelpers.bare'


# The page render tests. Each compares the whole render log of a page against the expected log.
# The test data, test/data/, is made by "make test-data" from the made-up companies in test/makeTestData.py.


# The index page: the companies that pass the screen, in rank order
async function testMain_index():
    data = testData(['data/meta.json', 'data/index.json'])
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/index.json'] \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                'Index | [Group totals](#var.vPage=\'totals\') | [Threshold explorer](#var.vPage=\'explore\') | [Methodology](#var.vPage=\'method\') | [Data and limits](#var.vPage=\'data\') | [Downloads](#var.vPage=\'downloads\')' \
            ] \
        ], \
        [ \
            'documentSetTitle', \
            ['The Treadmill Index'] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '# The Treadmill Index', \
                '', \
                'Large, growing companies whose revenue growth has not become meaningful cash for outside owners, because the cash', \
                'goes out as stock pay. Owner cash is free cash flow less stock-based compensation; "meaningful" is 3.0% of revenue.', \
                'Of 10 companies in the SEC data, 5 pass the screen and 4 are ranked. [How it is computed](#var.vPage=\'method\').', \
                '', \
                '## What a high rank can mean for a shareholder', \
                '', \
                '**The view behind this index.** Years of little owner cash at a large, growing company are not an accident. Pay and', \
                'spending are set by management and approved by the board every year. Insiders are paid in grants whether or not owners', \
                'ever see cash. And while owner cash stays near zero, the company cannot be valued on what it earns for its owners. It is', \
                'valued on revenue growth, or on profit measures that leave stock pay out. A valuation on owner cash, at the costs the', \
                'company itself reports, would be far lower, so there is a standing incentive never to let that figure settle. The', \
                'arrangement rewards the people who run it for keeping it going. The view of this index is that some companies keep it', \
                'going on purpose, at the expense of shareholders who take "investing in growth" on trust. The numbers alone cannot say', \
                'which companies: a real bet on growth looks the same until it pays off.', \
                '', \
                '**How to tell them apart.** A real growth bet shows up in time: costs fall as a share of revenue, owner cash appears as', \
                'growth slows, and insiders keep what they are granted. A treadmill does the opposite: costs rise with revenue, owner', \
                'cash stays near zero however large the company gets, and insiders sell what they are granted. Each company page shows', \
                'which way its numbers point. Insider grants and sales are not measured in this release.', \
                '', \
                'Together the 5 companies here recorded $6.5B of stock pay against $5.2B of free cash flow ([group totals](#var.vPage=\'totals\')).', \
                'Whatever the reason, this is what it costs a shareholder:', \
                '', \
                '- **Your share of the company shrinks.** Stock pay is paid in new shares. Unless the company buys them back, each', \
                '  existing share owns a smaller part of the company.', \
                '- **Buybacks may only hold the line.** Cash spent buying back shares and paying employees\' vesting taxes ($0.0B and $0.0B here)', \
                '  can go to offsetting new shares rather than to owners.', \
                '- **Headline profit leaves stock pay out.** Adjusted profit and free cash flow, which most earnings releases lead with,', \
                '  do not subtract it. That is legal and disclosed, but those measures can rise while owner cash stays near zero.', \
                '  Leaving out the capital-led companies, the group reported $4.1B of free cash flow and paid $5.3B in stock.', \
                '- **The company cannot be valued on what it earns.** Owner cash near zero gives nothing to value it on, so the price', \
                '  rests on revenue growth and on margins that have not arrived. At the costs the company reports today, the cash left', \
                '  for owners would support a far lower price. Growth can be bought with spending: 3 of the 4 ranked', \
                '  companies kept operating costs flat or rising as a share of revenue over five years.', \
                '- **A falling share price raises the cost.** The same pay takes more shares at a lower price, so dilution grows just', \
                '  when the price is weak, or pay has to move to cash.', \
                '', \
                '**What a rank does not prove.** A rank measures a pattern. It is not a finding about any one company\'s purpose, and not', \
                'a forecast that its shares will fall. 0 of the 5 had meaningful owner cash in their latest 12 months, and 1 are capital-led: their', \
                'shortfall is mostly investment. Each company page lists what cuts the other way.', \
                '', \
                '## The index' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '**Show:** Stock pay (5) | [Thin margin \\(1\\)](#var.vType=\'thin_margin\') | [Cash burner \\(1\\)](#var.vType=\'cash_burner\') | [Cash generative \\(1\\)](#var.vType=\'cash_generative\') | [Excluded industry \\(1\\)](#var.vType=\'excluded\') | [All \\(9\\)](#var.vType=\'all\') \\\n**Sort:** Rank | [P1](#var.vSort=\'p1\') | [Cumulative margin](#var.vSort=\'cum\') | [Latest margin](#var.vSort=\'latest\') | [Stock pay](#var.vSort=\'pay\') | [Revenue](#var.vSort=\'revenue\') | [Name](#var.vSort=\'name\')', \
                '', \
                '*Stock pay:* Passed the screen: owner cash is under the line and stock pay is the cause.' \
            ] \
        ], \
        [ \
            'elementModelRender', \
            [ \
                { \
                    'elem': [ \
                        {'elem': {'text': 'Find a company or ticker: '}, 'html': 'b'}, \
                        { \
                            'attr': { \
                                'autocomplete': 'off', \
                                'id': 'tiFind', \
                                'size': 30, \
                                'style': 'font-size: inherit; border: thin solid black; padding: 0.4em;', \
                                'type': 'text', \
                                'value': '' \
                            }, \
                            'callback': {'keyup': '<function>'}, \
                            'html': 'input' \
                        }, \
                        {'text': ' '}, \
                        { \
                            'attr': {'style': 'cursor: pointer; user-select: none;'}, \
                            'callback': {'click': '<function>'}, \
                            'elem': {'text': 'Find'}, \
                            'html': 'a' \
                        }, \
                        [] \
                    ], \
                    'html': 'p' \
                } \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                [ \
                    '| Rank | Company | Ticker | Screen score (50) | P1 (25) | P2b (13) | Cumulative owner-cash margin | Latest owner-cash margin | Stock pay / revenue | Latest revenue | Years | Notes |', \
                    '| --: | :-- | :-- | --: | --: | --: | --: | --: | --: | --: | :-- | :-- |', \
                    '| 1 | [One\\-Off Co](#var.vCik=6&var.vPage=\'company\') | OOC | 42.2 | 21.1 | 13.0 | -4.0% | -4.0% | 13.0% | $2,000M | 2019‑2025 | O F S |', \
                    '| 2 | [Stock Pay Co](#var.vCik=1&var.vPage=\'company\') | SPAY | 37.3 | 18.6 | 13.0 | -2.0% | -2.0% | 12.0% | $2,000M | 2019‑2025 |  |', \
                    '| 3 | [Capital & Sons \\[Holdings\\]](#var.vCik=2&var.vPage=\'company\') |  | 32.6 | 18.6 | 9.8 | -2.0% | -2.0% | 12.0% | $2,000M | 2019‑2025 | C |', \
                    '| 4 | [Marginal Co](#var.vCik=10&var.vPage=\'company\') | MARG | 25.9 | 13.0 | 13.0 | 2.6% | 2.6% | 7.4% | $2,000M | 2019‑2025 |  |', \
                    '|  | [No Cost Line Co](#var.vCik=3&var.vPage=\'company\') | NCL | n/a | 24.0 | n/a | -8.2% | -8.0% | 20.0% | $2,000M | 2019‑2025 | F N X |' \
                ] \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '**Rank** is by screen score, among the companies that pass the screen and have both pillars. Unranked companies are', \
                'listed for comparison only. **Cumulative** covers every fiscal year shown; **latest** is the latest 12 months.', \
                '', \
                '**The screen score is out of 50.** It is the automated, whole-market tier. The full score, out of 100, adds headcount,', \
                'insider selling and earnings-release framing for the top 25. It needs hand-checked data and is not published yet.', \
                'Screen scores must not be compared with full scores.', \
                '', \
                '**Neighbouring ranks are close.** Moving one threshold of the definition by a fifth changes the top ten in 3 of 24 tests.', \
                'Read a rank as a rough position, not a precise one. [Data and limits](#var.vPage=\'data\') lists every change.', \
                '', \
                '**Notes**', \
                '' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **C** - Capital-led: capital spending is more than twice stock pay, so the shortfall is mostly investment.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **O** - Inventory, lending or a discontinued business moved operating cash flow by more than a quarter of revenue in at least one year. The company page shows P1 with and without those years.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **F** - The latest fiscal year stands in for the latest 12 months, because the quarterly data is unusable or there is no later quarter.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **N** - The cost line cannot be built from the filing tags, so there is no P2b and no screen score. The company has P1 alone and is unranked.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **X** - No capital spending tag in at least one year; that year counts capital spending as zero.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            ['- **G** - At least one fiscal year is missing between the first and last year.'] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **J** - Revenue more than tripled in one year, which often marks a merger or a change of reporting entity.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '- **S** - The share count jumps in one year (a stock split, or a conversion at listing). Share counts are not adjusted.' \
            ] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '---', \
                '', \
                'Data as of 2026-11-05, from SEC filings. Method version 1.0.0.', \
                'History starts about 2009, when the SEC began collecting financial statements as data.', \
                '', \
                'The index ranks how outside owners have been treated. It is not a short list, a price forecast or investment advice,', \
                'and it makes no finding about any one company\'s intent.' \
            ] \
        ] \
    ])
endfunction
unittestRunTest('testMain_index')


# All types, sorted by P1, with more rows than the row limit
async function testMain_indexAll():
    data = testData(['data/meta.json', 'data/index.json'])
    systemGlobalSet('vType', 'all')
    systemGlobalSet('vSort', 'p1')
    systemGlobalSet('tiRowLimit', 3)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vType', null)
    systemGlobalSet('vSort', null)
    systemGlobalSet('tiRowLimit', 100)
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/index.json'] \

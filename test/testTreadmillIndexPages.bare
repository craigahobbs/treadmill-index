            [ \
                '[Index](#var=) | [Group totals](#var.vPage=\'totals\') | [Threshold explorer](#var.vPage=\'explore\') | [Methodology](#var.vPage=\'method\') | [Data and limits](#var.vPage=\'data\') | [Downloads](#var.vPage=\'downloads\')' \
            ] \
        ], \
        [ \
            'documentSetTitle', \
            ['The Treadmill Index'] \
        ], \
        [ \
            'markdownPrint', \
            [ \
                '', \
                '# The Treadmill Index', \
                '', \
                'Unknown company. Only companies that pass the basic tests have a page.' \

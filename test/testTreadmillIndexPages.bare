            [ \
                '', \
                '---', \
                '', \
                'Data as of 2026-11-05, from SEC filings. Method version 1.1.0.', \
                'History starts about 2009, when the SEC began collecting financial statements as data.', \
                '', \
                'The index ranks how outside owners have been treated. It is not a short list, a price forecast or investment advice,', \
                'and it makes no finding about any one company\'s intent.' \
            ] \
        ] \
    ])
endfunction
unittestRunTest('testMain_companyExcluded')


# No industry description or exchange
async function testMain_companyNoIndustryName():
    data = testData(['data/meta.json', 'data/company/7.json'])
    systemGlobalSet('vPage', 'company')
    systemGlobalSet('vCik', 7)
    unittestMockAll(data)
    tiMain()
    log = unittestMockEnd()
    systemGlobalSet('vPage', null)
    systemGlobalSet('vCik', null)
    unittestDeepEqual(log, [ \
        [ \
            'systemFetch', \
            [ \
                ['data/meta.json', 'data/company/7.json'] \
            ] \
        ], \
